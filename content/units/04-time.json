    { "id": "s-zuotianshixingqiwu", "hanzi": "昨天是星期五。", "pinyin": "Zuótiān shì xīngqīwǔ.", "english": "Yesterday was Friday.", "words": ["w-zuotian", "w-shi", "w-xingqi", "w-wu"] },
