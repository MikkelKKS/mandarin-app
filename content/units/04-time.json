  "grammar": [
    { "id": "g-clock", "title": "Telling the time: 点, 分, 半", "body": "Hour + 点: 两点 = two o'clock (use 两, not 二). Add minutes with 分: 七点十分 = 7:10. Half past is 半: 三点半 = 3:30.", "examples": ["s-xianzailiangdian", "s-qidianshifen", "s-sandianban"] },
    { "id": "g-ji", "title": "几 for number questions", "body": "几 asks for a small number and sits where the number would go: 几点 (what time), 星期几 (which weekday), 几月几号 (which date).", "examples": ["s-xianzaijidianle", "s-jintianxingqiji", "s-nideshengri"] },
    { "id": "g-timeorder", "title": "When comes before the verb", "body": "Time words go near the front, before the verb: 明天下午我回家 = tomorrow afternoon I go home. Never at the end like in English.", "examples": ["s-mingtianxiawuwohuijia", "s-womenjidianchifan"] },
    { "id": "g-dates", "title": "Dates go big to small", "body": "Month then day: 三月二十号 = 20 March. Weekdays are 星期 + number: 星期一 Monday … 星期六 Saturday; Sunday is 星期天.", "examples": ["s-wodeshengri", "s-jintianxingqiliu"] }
  ],
