  "grammar": [
    { "id": "g-xihuan", "title": "喜欢 + activity", "body": "Put the whole activity after 喜欢: 我喜欢看书 (I like reading), 我喜欢听音乐 (I like listening to music). Add 很 for 'really': 我很喜欢…", "examples": ["s-woxihuankanshu", "s-wohenxihuankandianying"] },
    { "id": "g-zui", "title": "最 = most / favourite", "body": "最 before a verb or adjective: 我最喜欢游泳 = I like swimming best / swimming is my favourite.", "examples": ["s-wozuixihuanyouyong"] },
    { "id": "g-juede", "title": "Opinions with 觉得", "body": "我觉得… = I think / I feel… Ask someone's view with 你觉得呢？ (what do you think?).", "examples": ["s-dianying-nijuedene", "s-wojuedehenyouyisi"] },
    { "id": "g-frequency", "title": "How often: before the verb", "body": "Words like 常常 (often) go before the verb, after the subject: 周末我常常去跑步.", "examples": ["s-zhoumopaobu"] }
