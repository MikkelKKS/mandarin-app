  "sentences": [
    { "id": "s-nixihuanzuoshenme", "hanzi": "你喜欢做什么？", "pinyin": "Nǐ xǐhuan zuò shénme?", "english": "What do you like doing?", "words": ["w-ni", "w-xihuan", "w-zuo-do", "w-shenme"] },
    { "id": "s-woxihuankanshu", "hanzi": "我喜欢看书。", "pinyin": "Wǒ xǐhuan kàn shū.", "english": "I like reading.", "words": ["w-wo", "w-xihuan", "w-kan", "w-shu"], "alt": { "english": ["I like reading books."] } },
    { "id": "s-wohenxihuankandianying", "hanzi": "我很喜欢看电影。", "pinyin": "Wǒ hěn xǐhuan kàn diànyǐng.", "english": "I really like watching films.", "words": ["w-wo", "w-hen", "w-xihuan", "w-kan", "w-dianying"] },
    { "id": "s-woxihuantingyinyue", "hanzi": "我喜欢听音乐。", "pinyin": "Wǒ xǐhuan tīng yīnyuè.", "english": "I like listening to music.", "words": ["w-wo", "w-xihuan", "w-ting", "w-yinyue"] },
    { "id": "s-tahenxihuanchangge", "hanzi": "她很喜欢唱歌。", "pinyin": "Tā hěn xǐhuan chànggē.", "english": "She loves singing.", "words": ["w-ta-she", "w-hen", "w-xihuan", "w-changge"] },
    { "id": "s-nixihuanyundongma", "hanzi": "你喜欢运动吗？", "pinyin": "Nǐ xǐhuan yùndòng ma?", "english": "Do you like sport?", "words": ["w-ni", "w-xihuan", "w-yundong", "w-ma"] },
    { "id": "s-wozuixihuanyouyong", "hanzi": "我最喜欢游泳。", "pinyin": "Wǒ zuì xǐhuan yóuyǒng.", "english": "Swimming is my favourite.", "words": ["w-wo", "w-zui", "w-xihuan", "w-youyong"], "alt": { "english": ["I like swimming best."] } },
    { "id": "s-wozuixihuankandianying", "hanzi": "我最喜欢看电影。", "pinyin": "Wǒ zuì xǐhuan kàn diànyǐng.", "english": "Watching films is my favourite.", "words": ["w-wo", "w-zui", "w-xihuan", "w-kan", "w-dianying"] },
    { "id": "s-wobuhuidalanqiu", "hanzi": "我不会打篮球。", "pinyin": "Wǒ bú huì dǎ lánqiú.", "english": "I can't play basketball.", "words": ["w-wo", "w-bu", "w-hui", "w-dalanqiu"] },
    { "id": "s-zhoumonizuoshenme", "hanzi": "周末你做什么？", "pinyin": "Zhōumò nǐ zuò shénme?", "english": "What do you do at the weekend?", "words": ["w-zhoumo", "w-ni", "w-zuo-do", "w-shenme"] },
    { "id": "s-mikkel-zhoumo", "hanzi": "米格，周末你做什么？", "pinyin": "Mǐgé, zhōumò nǐ zuò shénme?", "english": "米格, what do you do at the weekend?", "words": ["w-mikkel", "w-zhoumo", "w-ni", "w-zuo-do", "w-shenme"] },
    { "id": "s-zhoumopaobu", "hanzi": "周末我常常去跑步。", "pinyin": "Zhōumò wǒ chángcháng qù pǎobù.", "english": "At weekends I often go running.", "words": ["w-zhoumo", "w-wo", "w-changchang", "w-qu", "w-paobu"] },
    { "id": "s-zhoumopaobu-nine", "hanzi": "周末我常常去跑步。你呢？", "pinyin": "Zhōumò wǒ chángcháng qù pǎobù. Nǐ ne?", "english": "At weekends I often go running. And you?", "words": ["w-zhoumo", "w-wo", "w-changchang", "w-qu", "w-paobu", "w-ni", "w-ne"] },
    { "id": "s-babamamaxihuanlvyou", "hanzi": "我爸爸妈妈很喜欢旅游。", "pinyin": "Wǒ bàba māma hěn xǐhuan lǚyóu.", "english": "My parents love travelling.", "words": ["w-wo", "w-baba", "w-mama", "w-hen", "w-xihuan", "w-lvyou"] },
    { "id": "s-nihuidamajiangma", "hanzi": "你会打麻将吗？", "pinyin": "Nǐ huì dǎ májiàng ma?", "english": "Can you play mahjong?", "words": ["w-ni", "w-hui", "w-damajiang", "w-ma"] },
    { "id": "s-buhui-xiangxue", "hanzi": "不会，可是我想学！", "pinyin": "Bú huì, kěshì wǒ xiǎng xué!", "english": "No, but I'd like to learn!", "words": ["w-bu", "w-hui", "w-keshi", "w-wo", "w-xiang", "w-xue"] },
    { "id": "s-dianyinghenyouyisi", "hanzi": "这个电影很有意思。", "pinyin": "Zhège diànyǐng hěn yǒuyìsi.", "english": "This film is really interesting.", "words": ["w-zhe", "w-ge", "w-dianying", "w-hen", "w-youyisi"] },
    { "id": "s-dianying-nijuedene", "hanzi": "这个电影很有意思，你觉得呢？", "pinyin": "Zhège diànyǐng hěn yǒuyìsi, nǐ juéde ne?", "english": "This film is really good. What do you think?", "words": ["w-zhe", "w-ge", "w-dianying", "w-hen", "w-youyisi", "w-ni", "w-juede", "w-ne"] },
    { "id": "s-wojuedehenyouyisi", "hanzi": "我也觉得很有意思。", "pinyin": "Wǒ yě juéde hěn yǒuyìsi.", "english": "I think it's really good too.", "words": ["w-wo", "w-ye", "w-juede", "w-hen", "w-youyisi"] },
    { "id": "s-yiqikandianshi", "hanzi": "我们一起看电视吧。", "pinyin": "Wǒmen yìqǐ kàn diànshì ba.", "english": "Let's watch TV together.", "words": ["w-women", "w-yiqi", "w-kan", "w-dianshi", "w-ba-particle"] },
    { "id": "s-laiwojiawan", "hanzi": "周末来我家玩吧！", "pinyin": "Zhōumò lái wǒ jiā wán ba!", "english": "Come over to our place at the weekend!", "words": ["w-zhoumo", "w-lai", "w-wo", "w-jia", "w-wan-play", "w-ba-particle"] },
    { "id": "s-laiwojiawan-majiang", "hanzi": "周末来我家玩吧！我爸爸妈妈都会打麻将。", "pinyin": "Zhōumò lái wǒ jiā wán ba! Wǒ bàba māma dōu huì dǎ májiàng.", "english": "Come over at the weekend! My mum and dad both play mahjong.", "words": ["w-zhoumo", "w-lai", "w-wo", "w-jia", "w-wan-play", "w-ba-particle", "w-wo", "w-baba", "w-mama", "w-dou", "w-hui", "w-damajiang"] }
