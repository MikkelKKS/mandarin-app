 "grammar": [
  {
   "id": "g-zenmezou",
   "title": "怎么 + verb = how to",
   "body": "怎么走？ = how do I get there? (lit. how walk). Put the place first: 地铁站怎么走？",
   "examples": [
    "s-ditiezhanzenmezou"
   ]
  },
  {
   "id": "g-wang",
   "title": "往 + direction + 走",
   "body": "往左边走 = go left, 往右边走 = go right. 一直走 = go straight on.",
   "examples": [
    "s-wangzuobianzou",
    "s-yizhizou"
   ]
  },
  {
   "id": "g-li",
   "title": "Distance with 离",
   "body": "A 离 B 很近/很远 = A is close to / far from B: 我们家离地铁站很近.",
   "examples": [
    "s-lizhelihenjin",
    "s-yigexiaoshi-jin"
   ]
  },
  {
   "id": "g-congdao",
   "title": "从…到… = from…to…",
   "body": "从机场到你家 = from the airport to your home. Works for places and times.",
   "examples": [
    "s-congjichangdaonijia"
   ]
  },
  {
   "id": "g-zuo-transport",
   "title": "坐 = take (transport)",
   "body": "坐 (sit) is also how you 'take' transport: 坐地铁 (metro), 坐出租车 (taxi), 坐飞机 (plane).",
   "examples": [
    "s-zuoditiequba",
    "s-zuochuzuchequjichang"
   ]
  }
 ],
