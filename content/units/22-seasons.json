  "sentences": [
    { "id": "s22-nageijijie", "hanzi": "米格，你最喜欢哪个季节？", "pinyin": "Mǐgé, nǐ zuì xǐhuan nǎ ge jìjié?", "english": "米格, which season do you like best?", "words": ["w-mikkel", "w-ni", "w-zui", "w-xihuan", "w-na3", "w-ge", "w-jijie"] },
    { "id": "s22-zuixihuanqiutian", "hanzi": "我最喜欢秋天。", "pinyin": "Wǒ zuì xǐhuan qiūtiān.", "english": "I like autumn best.", "words": ["w-wo", "w-zui", "w-xihuan", "w-qiu", "w-tian"] },
    { "id": "s22-qiutianzuipiaoliang", "hanzi": "我也是！北京的秋天最漂亮。", "pinyin": "Wǒ yě shì! Běijīng de qiūtiān zuì piàoliang.", "english": "Me too! Autumn is the most beautiful season in Beijing.", "words": ["w-wo", "w-ye", "w-shi", "w-beijing", "w-de", "w-qiu", "w-tian", "w-zui", "w-piaoliang"] },
    { "id": "s22-chuntianne", "hanzi": "春天呢？", "pinyin": "Chūntiān ne?", "english": "And spring?", "words": ["w-chun", "w-tian", "w-ne"] },
    { "id": "s22-chuntianguafeng", "hanzi": "北京的春天常常刮风。", "pinyin": "Běijīng de chūntiān chángcháng guā fēng.", "english": "Spring in Beijing is often windy.", "words": ["w-beijing", "w-de", "w-chun", "w-tian", "w-changchang", "w-gua", "w-feng"] },
    { "id": "s22-dongtianxiatian", "hanzi": "冬天很冷，夏天很热。", "pinyin": "Dōngtiān hěn lěng, xiàtiān hěn rè.", "english": "Winters are cold and summers are hot.", "words": ["w-dong-winter", "w-tian", "w-hen", "w-leng", "w-xiatian", "w-hen", "w-re"] },
    { "id": "s22-guadafeng", "hanzi": "今天刮大风，别出去了。", "pinyin": "Jīntiān guā dà fēng, bié chūqù le.", "english": "It's really windy today. Don't go out.", "words": ["w-jintian", "w-gua", "w-da", "w-feng", "w-bie", "w-chu", "w-qu", "w-le"] },
    { "id": "s22-taiyangchulaile", "hanzi": "太阳出来了！", "pinyin": "Tàiyáng chūlái le!", "english": "The sun's come out!", "words": ["w-taiyang", "w-chu", "w-lai", "w-le"] },
    { "id": "s22-henduoyun", "hanzi": "天上有很多云。", "pinyin": "Tiān shàng yǒu hěn duō yún.", "english": "There are lots of clouds in the sky.", "words": ["w-tian", "w-shang", "w-you", "w-hen", "w-duo", "w-yun"] },
    { "id": "s22-yueliangpiaoliang", "hanzi": "今天晚上的月亮真漂亮！", "pinyin": "Jīntiān wǎnshang de yuèliang zhēn piàoliang!", "english": "The moon is beautiful tonight!", "words": ["w-jintian", "w-wanshang", "w-de", "w-yueliang", "w-zhen", "w-piaoliang"] },
    { "id": "s22-qugongyuan", "hanzi": "咱们去公园走走吧。", "pinyin": "Zánmen qù gōngyuán zǒuzou ba.", "english": "Let's go for a walk in the park.", "words": ["w-zanmen", "w-qu", "w-gongyuan", "w-zou", "w-zou", "w-ba-particle"] },
    { "id": "s22-caohenlv", "hanzi": "公园里的草很绿。", "pinyin": "Gōngyuán lǐ de cǎo hěn lǜ.", "english": "The grass in the park is very green.", "words": ["w-gongyuan", "w-li-inside", "w-de", "w-cao", "w-hen", "w-lv"] },
    { "id": "s22-henduoshu", "hanzi": "公园里有很多树。", "pinyin": "Gōngyuán lǐ yǒu hěn duō shù.", "english": "There are lots of trees in the park.", "words": ["w-gongyuan", "w-li-inside", "w-you", "w-hen", "w-duo", "w-shu-tree"] },
    { "id": "s22-huakaile", "hanzi": "花园里的花开了。", "pinyin": "Huāyuán lǐ de huā kāi le.", "english": "The flowers in the garden are out.", "words": ["w-huayuan", "w-li-inside", "w-de", "w-hua-flower", "w-kai", "w-le"] },
    { "id": "s22-maihua", "hanzi": "我给她妈妈买了一些花。", "pinyin": "Wǒ gěi tā māma mǎi le yìxiē huā.", "english": "I bought some flowers for her mother.", "words": ["w-wo", "w-gei", "w-ta-she", "w-mama", "w-mai3", "w-le", "w-yi", "w-xie", "w-hua-flower"] },
    { "id": "s22-heshangchuan", "hanzi": "河上有一条船。", "pinyin": "Hé shàng yǒu yì tiáo chuán.", "english": "There's a boat on the river.", "words": ["w-he-river", "w-shang", "w-you", "w-yi", "w-tiao", "w-chuan-boat"] },
    { "id": "s22-shushangniao", "hanzi": "树上有一只鸟。", "pinyin": "Shù shàng yǒu yì zhī niǎo.", "english": "There's a bird in the tree.", "words": ["w-shu-tree", "w-shang", "w-you", "w-yi", "w-zhi", "w-niao"] },
    { "id": "s22-shenmedongwu", "hanzi": "你喜欢什么动物？", "pinyin": "Nǐ xǐhuan shénme dòngwù?", "english": "What animals do you like?", "words": ["w-ni", "w-xihuan", "w-shenme", "w-dongwu"] },
    { "id": "s22-zuixihuanxiongmao", "hanzi": "我最喜欢熊猫。", "pinyin": "Wǒ zuì xǐhuan xióngmāo.", "english": "I like pandas best.", "words": ["w-wo", "w-zui", "w-xihuan", "w-xiongmao"] },
    { "id": "s22-xiongmaokeai", "hanzi": "熊猫太可爱了！", "pinyin": "Xióngmāo tài kě'ài le!", "english": "Pandas are so cute!", "words": ["w-xiongmao", "w-tai", "w-keai", "w-le"] },
    { "id": "s22-qiguoma", "hanzi": "你骑过马吗？", "pinyin": "Nǐ qí guo mǎ ma?", "english": "Have you ever ridden a horse?", "words": ["w-ni", "w-qi-ride", "w-guo-exp", "w-ma-horse", "w-ma"] },
    { "id": "s22-qupashan", "hanzi": "周末我们去爬山吧！", "pinyin": "Zhōumò wǒmen qù páshān ba!", "english": "Let's go hiking this weekend!", "words": ["w-zhoumo", "w-women", "w-qu", "w-pashan", "w-ba-particle"] },
    { "id": "s22-wangxizou", "hanzi": "好啊！往西走，一个小时就到了。", "pinyin": "Hǎo a! Wǎng xī zǒu, yí ge xiǎoshí jiù dào le.", "english": "Sure! Head west, it's only an hour.", "words": ["w-hao", "w-a", "w-wang", "w-xi-west", "w-zou", "w-yi", "w-ge", "w-xiaoshi", "w-jiu-just", "w-dao", "w-le"] },
    { "id": "s22-taihaole", "hanzi": "太好了！", "pinyin": "Tài hǎo le!", "english": "Great!", "words": ["w-tai", "w-hao", "w-le"] },
    { "id": "s22-wangdongnan", "hanzi": "往东走，然后往南走。", "pinyin": "Wǎng dōng zǒu, ránhòu wǎng nán zǒu.", "english": "Go east, then go south.", "words": ["w-wang", "w-dong-east", "w-zou", "w-ranhou", "w-wang", "w-nan-south", "w-zou"] },
    { "id": "s22-dongnanxibei", "hanzi": "北京人说路的时候，常常说东南西北。", "pinyin": "Běijīng rén shuō lù de shíhou, chángcháng shuō dōng nán xī běi.", "english": "When Beijingers give directions, they often use north, south, east and west.", "words": ["w-beijing", "w-ren", "w-shuo", "w-lu", "w-de", "w-shihou", "w-changchang", "w-shuo", "w-dong-east", "w-nan-south", "w-xi-west", "w-bei-north"] },
    { "id": "s22-beijingzaibeifang", "hanzi": "北京在中国的北方。", "pinyin": "Běijīng zài Zhōngguó de běifāng.", "english": "Beijing is in the north of China.", "words": ["w-beijing", "w-zai", "w-zhongguo", "w-de", "w-beifang"] },
    { "id": "s22-beifangrenmiantiao", "hanzi": "北方人很喜欢吃面条。", "pinyin": "Běifāng rén hěn xǐhuan chī miàntiáo.", "english": "Northerners love noodles.", "words": ["w-beifang", "w-ren", "w-hen", "w-xihuan", "w-chi", "w-miantiao"] }
