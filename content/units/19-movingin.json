  "grammar": [
    { "id": "g19-floor", "title": "Floors: 六楼, 六层", "body": "Say the floor as number + 楼: 我们住六楼. 层 also works: 住在六层.\nIn China, 一楼 is the ground floor.", "examples": ["s19-zhuliulou", "s19-zhujiceng"] },
    { "id": "g19-direction", "title": "走上去, 搬来", "body": "Add a direction after a verb: 上 (up), 下 (down), then 去 (away from the speaker) or 来 (towards the speaker). 走上去: walk up there. 搬来: move here.", "examples": ["s19-zoushangqu", "s19-xinbanlaide"] },
    { "id": "g19-shuawan", "title": "刷碗: northern for washing up", "body": "In Beijing people often say 刷碗 (scrub the bowls) for doing the dishes. 洗碗 means the same everywhere.", "examples": ["s19-wolaishuawan"] },
    { "id": "g19-huan", "title": "换: change or replace", "body": "换 means to swap one thing for another: 换衣服 (change clothes), 换一个新的 (get a new one).", "examples": ["s19-denghuanyige", "s19-shoujitaijiu", "s19-huanjianyifu"] }
  ],
