  "sentences": [
    { "id": "s19-xiageyuebanjia", "hanzi": "我们下个月搬家。", "pinyin": "Wǒmen xià ge yuè bānjiā.", "english": "We're moving next month.", "words": ["w-women", "w-xia", "w-ge", "w-yue", "w-ban-move", "w-jia"] },
    { "id": "s19-xinbanlaide", "hanzi": "你好！你们是新搬来的吗？", "pinyin": "Nǐ hǎo! Nǐmen shì xīn bān lái de ma?", "english": "Hello! Have you just moved in?", "words": ["w-nihao", "w-ni", "w-men", "w-shi", "w-xin", "w-ban-move", "w-lai", "w-de", "w-ma"] },
    { "id": "s19-zhuliulou", "hanzi": "对，我们住六楼。", "pinyin": "Duì, wǒmen zhù liù lóu.", "english": "Yes, we live on the sixth floor.", "words": ["w-dui", "w-women", "w-zhu", "w-liu", "w-lou"] },
    { "id": "s19-zhujiceng", "hanzi": "你住在几层？", "pinyin": "Nǐ zhù zài jǐ céng?", "english": "Which floor do you live on?", "words": ["w-ni", "w-zhu", "w-zai", "w-ji", "w-ceng"] },
    { "id": "s19-youdiantima", "hanzi": "有电梯吗？", "pinyin": "Yǒu diàntī ma?", "english": "Is there a lift?", "words": ["w-you", "w-dianti", "w-ma"] },
    { "id": "s19-diantihuaile", "hanzi": "电梯坏了！", "pinyin": "Diàntī huài le!", "english": "The lift is broken!", "words": ["w-dianti", "w-huai", "w-le"] },
    { "id": "s19-zoushangqu", "hanzi": "没事儿，我们走上去。", "pinyin": "Méishìr, wǒmen zǒu shàngqù.", "english": "No worries, we'll walk up.", "words": ["w-meishir", "w-women", "w-zou", "w-shang", "w-qu"] },
    { "id": "s19-xinlinju", "hanzi": "你好，我是你的新邻居。", "pinyin": "Nǐ hǎo, wǒ shì nǐ de xīn línjū.", "english": "Hello, I'm your new neighbour.", "words": ["w-ni", "w-hao", "w-wo", "w-shi", "w-ni", "w-de", "w-xin", "w-linju"] },
    { "id": "s19-wolaibangnimen", "hanzi": "我来帮你们！", "pinyin": "Wǒ lái bāng nǐmen!", "english": "Let me help you!", "words": ["w-wo", "w-lai", "w-bang", "w-ni", "w-men"] },
    { "id": "s19-taixiexienin", "hanzi": "太谢谢你了！", "pinyin": "Tài xièxie nǐ le!", "english": "Thank you so much!", "words": ["w-tai", "w-xiexie", "w-ni", "w-le"] },
    { "id": "s19-chufanghenxiao", "hanzi": "厨房很小，可是很干净。", "pinyin": "Chúfáng hěn xiǎo, kěshì hěn gānjìng.", "english": "The kitchen is small, but it's clean.", "words": ["w-chufang", "w-hen", "w-xiao", "w-keshi", "w-hen", "w-ganjing"] },
    { "id": "s19-bingxiangliyou", "hanzi": "冰箱里有什么？", "pinyin": "Bīngxiāng lǐ yǒu shénme?", "english": "What's in the fridge?", "words": ["w-bingxiang", "w-li-inside", "w-you", "w-shenme"] },
    { "id": "s19-niunaijidan", "hanzi": "冰箱里有牛奶和鸡蛋。", "pinyin": "Bīngxiāng lǐ yǒu niúnǎi hé jīdàn.", "english": "There's milk and eggs in the fridge.", "words": ["w-bingxiang", "w-li-inside", "w-you", "w-niunai", "w-he", "w-jidan"] },
    { "id": "s19-kaikongtiao", "hanzi": "太热了，开空调吧。", "pinyin": "Tài rè le, kāi kōngtiáo ba.", "english": "It's too hot. Let's turn on the air con.", "words": ["w-tai", "w-re", "w-le", "w-kai", "w-kongtiao", "w-ba-particle"] },
    { "id": "s19-guandeng", "hanzi": "出门的时候，别忘记关灯。", "pinyin": "Chū mén de shíhou, bié wàngjì guān dēng.", "english": "Don't forget to turn off the lights when you go out.", "words": ["w-chu", "w-men-door", "w-de", "w-shihou", "w-bie", "w-wangji", "w-guan", "w-deng-lamp"] },
    { "id": "s19-denghuanyige", "hanzi": "灯坏了，我们换一个吧。", "pinyin": "Dēng huài le, wǒmen huàn yí ge ba.", "english": "The light's broken. Let's replace it.", "words": ["w-deng-lamp", "w-huai", "w-le", "w-women", "w-huan", "w-yi", "w-ge", "w-ba-particle"] },
    { "id": "s19-huanjianyifu", "hanzi": "我去换件衣服。", "pinyin": "Wǒ qù huàn jiàn yīfu.", "english": "I'll go and change my clothes.", "words": ["w-wo", "w-qu", "w-huan", "w-jian-item", "w-yifu"] },
    { "id": "s19-shoujitaijiu", "hanzi": "我的手机太旧了，想换一个新的。", "pinyin": "Wǒ de shǒujī tài jiù le, xiǎng huàn yí ge xīn de.", "english": "My phone is too old. I want a new one.", "words": ["w-wo", "w-de", "w-shouji", "w-tai", "w-jiu-old", "w-le", "w-xiang", "w-huan", "w-yi", "w-ge", "w-xin", "w-de"] },
    { "id": "s19-zhuozihenjiu", "hanzi": "这张桌子很旧了。", "pinyin": "Zhè zhāng zhuōzi hěn jiù le.", "english": "This table is quite old.", "words": ["w-zhe", "w-zhang", "w-zhuozi", "w-hen", "w-jiu-old", "w-le"] },
    { "id": "s19-yiqidasao", "hanzi": "周末我们一起打扫房间吧。", "pinyin": "Zhōumò wǒmen yìqǐ dǎsǎo fángjiān ba.", "english": "Let's clean the flat together this weekend.", "words": ["w-zhoumo", "w-women", "w-yiqi", "w-dasao", "w-fangjian", "w-ba-particle"] },
    { "id": "s19-dasaodehenganjing", "hanzi": "房间打扫得很干净。", "pinyin": "Fángjiān dǎsǎo de hěn gānjìng.", "english": "The room has been cleaned really well.", "words": ["w-fangjian", "w-dasao", "w-de-particle", "w-hen", "w-ganjing"] },
    { "id": "s19-wolaishuawan", "hanzi": "我来刷碗！", "pinyin": "Wǒ lái shuā wǎn!", "english": "I'll do the dishes!", "words": ["w-wo", "w-lai", "w-shua", "w-wan"] },
    { "id": "s19-xianquxizao", "hanzi": "你先去洗澡吧。", "pinyin": "Nǐ xiān qù xǐzǎo ba.", "english": "You go and shower first.", "words": ["w-ni", "w-xian", "w-qu", "w-xizao", "w-ba-particle"] },
    { "id": "s19-panzizainar", "hanzi": "盘子在哪儿？", "pinyin": "Pánzi zài nǎr?", "english": "Where are the plates?", "words": ["w-panzi", "w-zai", "w-nar"], "alt": { "pinyin": ["Pánzi zài nǎlǐ?"] } },
    { "id": "s19-bapanzifang", "hanzi": "把盘子放在桌子上。", "pinyin": "Bǎ pánzi fàng zài zhuōzi shàng.", "english": "Put the plates on the table.", "words": ["w-ba-object", "w-panzi", "w-fang-put", "w-zai", "w-zhuozi", "w-shang"] },
    { "id": "s19-henfangbian", "hanzi": "这儿离地铁站很近，很方便。", "pinyin": "Zhèr lí dìtiě zhàn hěn jìn, hěn fāngbiàn.", "english": "It's close to the subway station here. Very convenient.", "words": ["w-zher", "w-li-from", "w-ditie", "w-zhan", "w-hen", "w-jin-near", "w-hen", "w-fangbian"] },
    { "id": "s19-fujinfanguan", "hanzi": "附近有很多饭馆，很方便。", "pinyin": "Fùjìn yǒu hěn duō fànguǎn, hěn fāngbiàn.", "english": "There are lots of restaurants nearby. Very handy.", "words": ["w-fujin", "w-you", "w-hen", "w-duo", "w-fanguan", "w-hen", "w-fangbian"] },
    { "id": "s19-fujinyoufanguanma", "hanzi": "附近有饭馆吗？", "pinyin": "Fùjìn yǒu fànguǎn ma?", "english": "Are there any restaurants nearby?", "words": ["w-fujin", "w-you", "w-fanguan", "w-ma"] },
    { "id": "s19-huanjinghenhao", "hanzi": "这儿环境很好，很安静。", "pinyin": "Zhèr huánjìng hěn hǎo, hěn ānjìng.", "english": "It's a nice area here, very quiet.", "words": ["w-zher", "w-huanjing", "w-hen", "w-hao", "w-hen", "w-anjing"] },
    { "id": "s19-zhongjian", "hanzi": "我们家在商店和饭馆中间。", "pinyin": "Wǒmen jiā zài shāngdiàn hé fànguǎn zhōngjiān.", "english": "Our home is between the shop and the restaurant.", "words": ["w-women", "w-jia", "w-zai", "w-shangdian", "w-he", "w-fanguan", "w-zhongjian"] },
    { "id": "s19-jiedaohenganjing", "hanzi": "这儿的街道很干净。", "pinyin": "Zhèr de jiēdào hěn gānjìng.", "english": "The streets here are very clean.", "words": ["w-zher", "w-de", "w-jiedao", "w-hen", "w-ganjing"] }
  ],
