  "sentences": [
    { "id": "s-zhoumoyoukongma", "hanzi": "周末你有空吗？", "pinyin": "Zhōumò nǐ yǒu kòng ma?", "english": "Are you free at the weekend?", "words": ["w-zhoumo", "w-ni", "w-youkong", "w-ma"] },
    { "id": "s-mikkel-xingqiliuyoukong", "hanzi": "米格，星期六你有空吗？", "pinyin": "Mǐgé, xīngqīliù nǐ yǒu kòng ma?", "english": "Mi'ge, are you free on Saturday?", "words": ["w-mikkel", "w-xingqi", "w-liu", "w-ni", "w-youkong", "w-ma"] },
    { "id": "s-youkong", "hanzi": "有空。", "pinyin": "Yǒu kòng.", "english": "Yes, I'm free.", "words": ["w-youkong"] },
    { "id": "s-youkong-dasuan", "hanzi": "有空。你打算做什么？", "pinyin": "Yǒu kòng. Nǐ dǎsuàn zuò shénme?", "english": "I'm free. What are you planning?", "words": ["w-youkong", "w-ni", "w-dasuan", "w-zuo-do", "w-shenme"] },
    { "id": "s-meiyoushijian", "hanzi": "对不起，我没有时间。", "pinyin": "Duìbuqǐ, wǒ méiyǒu shíjiān.", "english": "Sorry, I don't have time.", "words": ["w-duibuqi", "w-wo", "w-mei", "w-you", "w-shijian"] },
    { "id": "s-qufanguanchifan", "hanzi": "我们去饭馆吃饭吧。", "pinyin": "Wǒmen qù fànguǎn chīfàn ba.", "english": "Let's eat out at a restaurant.", "words": ["w-women", "w-qu", "w-fanguan", "w-chi", "w-fan", "w-ba-particle"] },
    { "id": "s-hebeikafei", "hanzi": "我们去喝杯咖啡，怎么样？", "pinyin": "Wǒmen qù hē bēi kāfēi, zěnmeyàng?", "english": "How about going for a coffee?", "words": ["w-women", "w-qu", "w-he-drink", "w-bei", "w-kafei", "w-zenmeyang"] },
    { "id": "s-taihaole", "hanzi": "太好了！", "pinyin": "Tài hǎo le!", "english": "Great!", "words": ["w-tai", "w-hao", "w-le"] },
    { "id": "s-taihaole-jidian", "hanzi": "太好了！几点见面？", "pinyin": "Tài hǎo le! Jǐ diǎn jiànmiàn?", "english": "Great! What time shall we meet?", "words": ["w-tai", "w-hao", "w-le", "w-ji", "w-dian", "w-jianmian"] },
    { "id": "s-xingqiliujianmian", "hanzi": "我们星期六见面吧。", "pinyin": "Wǒmen xīngqīliù jiànmiàn ba.", "english": "Let's meet on Saturday.", "words": ["w-women", "w-xingqi", "w-liu", "w-jianmian", "w-ba-particle"] },
    { "id": "s-jidianjianmian", "hanzi": "几点见面？", "pinyin": "Jǐ diǎn jiànmiàn?", "english": "What time shall we meet?", "words": ["w-ji", "w-dian", "w-jianmian"] },
    { "id": "s-xiawuliangdianba", "hanzi": "下午两点吧。", "pinyin": "Xiàwǔ liǎng diǎn ba.", "english": "Let's say two in the afternoon.", "words": ["w-xiawu", "w-liang", "w-dian", "w-ba-particle"] },
    { "id": "s-nidasuanzuoshenme", "hanzi": "明天你打算做什么？", "pinyin": "Míngtiān nǐ dǎsuàn zuò shénme?", "english": "What are you planning to do tomorrow?", "words": ["w-mingtian", "w-ni", "w-dasuan", "w-zuo-do", "w-shenme"] },
    { "id": "s-wokenengquyouyong", "hanzi": "我可能去游泳。", "pinyin": "Wǒ kěnéng qù yóuyǒng.", "english": "I might go swimming.", "words": ["w-wo", "w-keneng", "w-qu", "w-youyong"] },
    { "id": "s-meiwenti", "hanzi": "没问题！", "pinyin": "Méi wèntí!", "english": "No problem!", "words": ["w-mei", "w-wenti"] },
    { "id": "s-woyidinglai", "hanzi": "我一定来！", "pinyin": "Wǒ yídìng lái!", "english": "I'll definitely come!", "words": ["w-wo", "w-yiding", "w-lai"] },
    { "id": "s-xiaciba", "hanzi": "下次吧。", "pinyin": "Xià cì ba.", "english": "Next time, then.", "words": ["w-xia", "w-ci", "w-ba-particle"] },
    { "id": "s-dengwowufenzhong", "hanzi": "等我五分钟。", "pinyin": "Děng wǒ wǔ fēnzhōng.", "english": "Give me five minutes.", "words": ["w-deng", "w-wo", "w-wu", "w-fenzhong"] },
    { "id": "s-duibuqiwomashangdao", "hanzi": "对不起，我马上到！", "pinyin": "Duìbuqǐ, wǒ mǎshàng dào!", "english": "Sorry, I'll be right there!", "words": ["w-duibuqi", "w-wo", "w-mashang", "w-dao"] },
    { "id": "s-duibuqiwochidaole", "hanzi": "对不起，我迟到了。", "pinyin": "Duìbuqǐ, wǒ chídào le.", "english": "Sorry I'm late.", "words": ["w-duibuqi", "w-wo", "w-chidao", "w-le"] },
