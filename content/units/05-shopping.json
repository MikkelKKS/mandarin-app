    { "id": "s-sishikuaikeyima", "hanzi": "四十块可以吗？", "pinyin": "Sìshí kuài kěyǐ ma?", "english": "Is forty OK?", "words": ["w-si", "w-shi2", "w-kuai", "w-keyi", "w-ma"] },
