  "grammar": [
    { "id": "g-price", "title": "Asking the price", "body": "这个多少钱？ = how much is this? Prices are said with 块 (kuài): 五十块 = 50 yuan. Shops write 元, but nobody says it.", "examples": ["s-zhegeduoshaoqian", "s-wushikuai"] },
    { "id": "g-perunit", "title": "Price per unit", "body": "At markets, fruit and vegetables are priced per 斤 (jīn, half a kilo): 苹果多少钱一斤？ → 一斤八块 (eight yuan a jin).", "examples": ["s-pingguoduoshaoqianyijin", "s-yijinbakuai"] },
    { "id": "g-maimai", "title": "买 mǎi vs 卖 mài", "body": "Buy and sell differ only in tone: 买 mǎi (3rd, buy) and 卖 mài (4th, sell). A great test for your ear!", "examples": ["s-woyaomaipingguo", "s-shangdianmaishenme"] },
    { "id": "g-gift", "title": "Giving and receiving gifts", "body": "Bring fruit or something small when visiting family. When you're given something, 你太客气了 (you're too kind) is the classic polite reply.", "examples": ["s-zheshigeinindeliwu", "s-nitaikeqile"] }
  ],
