    { "id": "s-woyaomaipingguo", "hanzi": "我要买苹果。", "pinyin": "Wǒ yào mǎi píngguǒ.", "english": "I'd like to buy apples.", "words": ["w-wo", "w-yao", "w-mai3", "w-pingguo"] },
    { "id": "s-pingguoduoshaoqianyijin", "hanzi": "苹果多少钱一斤？", "pinyin": "Píngguǒ duōshao qián yì jīn?", "english": "How much are the apples per jin?", "words": ["w-pingguo", "w-duoshao", "w-qian", "w-yi", "w-jin-weight"] },
    { "id": "s-maipingguo-duoshao", "hanzi": "我要买苹果。苹果多少钱一斤？", "pinyin": "Wǒ yào mǎi píngguǒ. Píngguǒ duōshao qián yì jīn?", "english": "I'd like some apples. How much are they per jin?", "words": ["w-wo", "w-yao", "w-mai3", "w-pingguo", "w-pingguo", "w-duoshao", "w-qian", "w-yi", "w-jin-weight"] },
    { "id": "s-yijinbakuai", "hanzi": "一斤八块。", "pinyin": "Yì jīn bā kuài.", "english": "Eight yuan a jin.", "words": ["w-yi", "w-jin-weight", "w-ba", "w-kuai"] },
    { "id": "s-qikuaikeyima", "hanzi": "七块，可以吗？", "pinyin": "Qī kuài, kěyǐ ma?", "english": "Seven yuan, OK?", "words": ["w-qi", "w-kuai", "w-keyi", "w-ma"] },
    { "id": "s-niyaojijin", "hanzi": "你要几斤？", "pinyin": "Nǐ yào jǐ jīn?", "english": "How many jin would you like?", "words": ["w-ni", "w-yao", "w-ji", "w-jin-weight"] },
    { "id": "s-woyaoliangjin", "hanzi": "我要两斤。", "pinyin": "Wǒ yào liǎng jīn.", "english": "I'll take two jin.", "words": ["w-wo", "w-yao", "w-liang", "w-jin-weight"] },
    { "id": "s-keyi-liangjin", "hanzi": "可以。我要两斤。", "pinyin": "Kěyǐ. Wǒ yào liǎng jīn.", "english": "OK. I'll take two jin.", "words": ["w-keyi", "w-wo", "w-yao", "w-liang", "w-jin-weight"] },
    { "id": "s-yigongshisikuai", "hanzi": "一共十四块。", "pinyin": "Yígòng shísì kuài.", "english": "That's fourteen yuan altogether.", "words": ["w-yigong", "w-shi2", "w-si", "w-kuai"] },
    { "id": "s-yigongshiliukuai", "hanzi": "一共十六块。", "pinyin": "Yígòng shíliù kuài.", "english": "That's sixteen yuan altogether.", "words": ["w-yigong", "w-shi2", "w-liu", "w-kuai"] },
    { "id": "s-womenqushangdianba", "hanzi": "我们去商店吧。", "pinyin": "Wǒmen qù shāngdiàn ba.", "english": "Let's go to the shop.", "words": ["w-women", "w-qu", "w-shangdian", "w-ba-particle"] },
    { "id": "s-maishuiguo", "hanzi": "我想买水果。", "pinyin": "Wǒ xiǎng mǎi shuǐguǒ.", "english": "I'd like to buy some fruit.", "words": ["w-wo", "w-xiang", "w-mai3", "w-shuiguo"] },
    { "id": "s-zhejianyifu", "hanzi": "这件衣服很漂亮。", "pinyin": "Zhè jiàn yīfu hěn piàoliang.", "english": "This top is really nice.", "words": ["w-zhe", "w-jian-item", "w-yifu", "w-hen", "w-piaoliang"], "alt": { "english": ["This piece of clothing is really pretty."] } },
