    { "id": "s-heshenme-yaobuyao", "hanzi": "你想喝什么？要不要喝茶？", "pinyin": "Nǐ xiǎng hē shénme? Yào bu yào hē chá?", "english": "What would you like to drink? Some tea?", "words": ["w-ni", "w-xiang", "w-he-drink", "w-shenme", "w-yao", "w-bu", "w-yao", "w-he-drink", "w-cha"] },
