    { "id": "s-haoa", "hanzi": "好啊！", "pinyin": "Hǎo a!", "english": "Sure!", "words": ["w-hao", "w-a"], "alt": { "english": ["Okay!", "Yes, please!"] } },
    { "id": "s-haoa-xiexieayi", "hanzi": "好啊，谢谢阿姨！", "pinyin": "Hǎo a, xièxie āyí!", "english": "Yes please, thank you!", "words": ["w-hao", "w-a", "w-xiexie", "w-ayi"] },
    { "id": "s-geiwoyibeishui", "hanzi": "请给我一杯水。", "pinyin": "Qǐng gěi wǒ yì bēi shuǐ.", "english": "Could I have a glass of water, please?", "words": ["w-qing", "w-gei", "w-wo", "w-yi", "w-bei", "w-shui"] },
