    { "id": "s-nixihuanchijiaozima", "hanzi": "你喜欢吃饺子吗？", "pinyin": "Nǐ xǐhuan chī jiǎozi ma?", "english": "Do you like dumplings?", "words": ["w-ni", "w-xihuan", "w-chi", "w-jiaozi", "w-ma"] },
