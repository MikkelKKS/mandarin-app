    { "id": "s17-jidianqichuang", "hanzi": "你每天几点起床？", "pinyin": "Nǐ měitiān jǐ diǎn qǐchuáng?", "english": "What time do you get up every day?", "words": ["w-ni", "w-meitian", "w-ji", "w-dian", "w-qichuang"] },
    { "id": "s17-qidianqichuang", "hanzi": "我七点起床。", "pinyin": "Wǒ qī diǎn qǐchuáng.", "english": "I get up at seven.", "words": ["w-wo", "w-qi", "w-dian", "w-qichuang"] },
    { "id": "s17-wolaixiwan", "hanzi": "我来洗碗吧！", "pinyin": "Wǒ lái xǐ wǎn ba!", "english": "Let me do the dishes!", "words": ["w-wo", "w-lai", "w-xi", "w-wan", "w-ba-particle"] },
    { "id": "s17-xiyifu", "hanzi": "我今天要洗衣服。", "pinyin": "Wǒ jīntiān yào xǐ yīfu.", "english": "I need to do the laundry today.", "words": ["w-wo", "w-jintian", "w-yao", "w-xi", "w-yifu"] },
    { "id": "s17-babakanbaozhi", "hanzi": "爸爸正在看报纸。", "pinyin": "Bàba zhèngzài kàn bàozhǐ.", "english": "Dad is reading the newspaper.", "words": ["w-baba", "w-zhengzai", "w-kan", "w-baozhi"] },
    { "id": "s17-zuozhekanbaozhi", "hanzi": "他坐着看报纸。", "pinyin": "Tā zuò zhe kàn bàozhǐ.", "english": "He's sitting reading the paper.", "words": ["w-ta-he", "w-zuo", "w-zhe-particle", "w-kan", "w-baozhi"] },
    { "id": "s17-chuanzhehongyifu", "hanzi": "她穿着一件红衣服。", "pinyin": "Tā chuān zhe yí jiàn hóng yīfu.", "english": "She's wearing a red top.", "words": ["w-ta-she", "w-chuan", "w-zhe-particle", "w-yi", "w-jian-item", "w-hong", "w-yifu"] },
    { "id": "s17-zhengzaixuexi", "hanzi": "我正在学习中文。", "pinyin": "Wǒ zhèngzài xuéxí Zhōngwén.", "english": "I'm learning Chinese at the moment.", "words": ["w-wo", "w-zhengzai", "w-xuexi", "w-zhongwen"] },
    { "id": "s17-mamarangwochi", "hanzi": "妈妈让我多吃点。", "pinyin": "Māma ràng wǒ duō chī diǎn.", "english": "Mum makes me eat more.", "words": ["w-mama", "w-rang", "w-wo", "w-duo", "w-chi", "w-dian"] },
    { "id": "s17-rangwolai", "hanzi": "让我来吧！", "pinyin": "Ràng wǒ lái ba!", "english": "Let me do it!", "words": ["w-rang", "w-wo", "w-lai", "w-ba-particle"] },
    { "id": "s17-jiudiankaishi", "hanzi": "我们九点开始上课。", "pinyin": "Wǒmen jiǔ diǎn kāishǐ shàngkè.", "english": "Our class starts at nine.", "words": ["w-women", "w-jiu", "w-dian", "w-kaishi", "w-shang", "w-ke"] },
    { "id": "s17-meiyouke", "hanzi": "今天没有课。", "pinyin": "Jīntiān méiyǒu kè.", "english": "There's no class today.", "words": ["w-jintian", "w-mei", "w-you", "w-ke"] },
    { "id": "s17-jiaoshizainar", "hanzi": "教室在哪儿？", "pinyin": "Jiàoshì zài nǎr?", "english": "Where's the classroom?", "words": ["w-jiaoshi", "w-zai", "w-nar"], "alt": { "pinyin": ["Jiàoshì zài nǎlǐ?"] } },
    { "id": "s17-mingtiankaoshi", "hanzi": "我明天有考试。", "pinyin": "Wǒ míngtiān yǒu kǎoshì.", "english": "I have an exam tomorrow.", "words": ["w-wo", "w-mingtian", "w-you", "w-kaoshi"] },
    { "id": "s17-kaoshinanma", "hanzi": "考试难吗？", "pinyin": "Kǎoshì nán ma?", "english": "Was the exam hard?", "words": ["w-kaoshi", "w-nan2", "w-ma"], "alt": { "english": ["Is the exam hard?"] } },
    { "id": "s17-tibutainan", "hanzi": "题不太难。", "pinyin": "Tí bú tài nán.", "english": "The questions weren't too hard.", "words": ["w-ti", "w-bu", "w-tai", "w-nan2"], "alt": { "english": ["The questions aren't too hard."] } },
    { "id": "s17-diyitizuocuole", "hanzi": "第一题我做错了。", "pinyin": "Dìyī tí wǒ zuò cuò le.", "english": "I got the first question wrong.", "words": ["w-diyi", "w-ti", "w-wo", "w-zuo-do", "w-cuo", "w-le"] },
    { "id": "s17-diyicilai", "hanzi": "这是我第一次来中国。", "pinyin": "Zhè shì wǒ dìyī cì lái Zhōngguó.", "english": "This is my first time in China.", "words": ["w-zhe", "w-shi", "w-wo", "w-diyi", "w-ci", "w-lai", "w-zhongguo"] },
    { "id": "s17-chiwanle", "hanzi": "我吃完了。", "pinyin": "Wǒ chī wán le.", "english": "I've finished eating.", "words": ["w-wo", "w-chi", "w-wan-finish", "w-le"] },
    { "id": "s17-kanwanshu", "hanzi": "你看完这本书了吗？", "pinyin": "Nǐ kàn wán zhè běn shū le ma?", "english": "Have you finished this book?", "words": ["w-ni", "w-kan", "w-wan-finish", "w-zhe", "w-ben", "w-shu", "w-le", "w-ma"] },
    { "id": "s17-shuodehenhao", "hanzi": "你中文说得很好！", "pinyin": "Nǐ Zhōngwén shuō de hěn hǎo!", "english": "You speak Chinese really well!", "words": ["w-ni", "w-zhongwen", "w-shuo", "w-de-particle", "w-hen", "w-hao"] },
    { "id": "s17-nalinali", "hanzi": "哪里哪里，我说得不好。", "pinyin": "Nǎlǐ nǎlǐ, wǒ shuō de bù hǎo.", "english": "Oh, not really. I don't speak it well.", "words": ["w-nali", "w-nali", "w-wo", "w-shuo", "w-de-particle", "w-bu", "w-hao"] },
    { "id": "s17-tingdedongma", "hanzi": "你听得懂吗？", "pinyin": "Nǐ tīng de dǒng ma?", "english": "Can you understand?", "words": ["w-ni", "w-ting", "w-de-particle", "w-dong", "w-ma"] },
    { "id": "s17-tingbudong", "hanzi": "对不起，我听不懂。", "pinyin": "Duìbuqǐ, wǒ tīng bu dǒng.", "english": "Sorry, I don't understand.", "words": ["w-duibuqi", "w-wo", "w-ting", "w-bu", "w-dong"] },
    { "id": "s17-dongle", "hanzi": "我懂了。", "pinyin": "Wǒ dǒng le.", "english": "I get it.", "words": ["w-wo", "w-dong", "w-le"], "alt": { "english": ["I understand now."] } },
    { "id": "s17-shenmeyisi", "hanzi": "这是什么意思？", "pinyin": "Zhè shì shénme yìsi?", "english": "What does this mean?", "words": ["w-zhe", "w-shi", "w-shenme", "w-yisi"] },
    { "id": "s17-tingbudong-yisi", "hanzi": "对不起，我听不懂。这是什么意思？", "pinyin": "Duìbuqǐ, wǒ tīng bu dǒng. Zhè shì shénme yìsi?", "english": "Sorry, I don't understand. What does it mean?", "words": ["w-duibuqi", "w-wo", "w-ting", "w-bu", "w-dong", "w-zhe", "w-shi", "w-shenme", "w-yisi"] },
    { "id": "s17-keyiwenwenti", "hanzi": "我可以问一个问题吗？", "pinyin": "Wǒ kěyǐ wèn yí ge wèntí ma?", "english": "Can I ask a question?", "words": ["w-wo", "w-keyi", "w-wen", "w-yi", "w-ge", "w-wenti", "w-ma"] },
    { "id": "s17-buhuihuida", "hanzi": "这个问题我不会回答。", "pinyin": "Zhège wèntí wǒ bú huì huídá.", "english": "I don't know how to answer this question.", "words": ["w-zhe", "w-ge", "w-wenti", "w-wo", "w-bu", "w-hui", "w-huida"] },
    { "id": "s17-mamagaosuwo", "hanzi": "妈妈告诉我，你明天考试。", "pinyin": "Māma gàosu wǒ, nǐ míngtiān kǎoshì.", "english": "Mum told me you have an exam tomorrow.", "words": ["w-mama", "w-gaosu", "w-wo", "w-ni", "w-mingtian", "w-kaoshi"] },
    { "id": "s17-meiguanxi-gaosuni", "hanzi": "没关系，我告诉你。", "pinyin": "Méi guānxi, wǒ gàosu nǐ.", "english": "No problem, I'll tell you.", "words": ["w-meiguanxi", "w-wo", "w-gaosu", "w-ni"] },
    { "id": "s17-xiexiebangzhu", "hanzi": "谢谢你的帮助！", "pinyin": "Xièxie nǐ de bāngzhù!", "english": "Thanks for your help!", "words": ["w-xiexie", "w-ni", "w-de", "w-bangzhu"] },
    { "id": "s17-dajiahao", "hanzi": "大家好！", "pinyin": "Dàjiā hǎo!", "english": "Hi, everyone!", "words": ["w-dajia", "w-hao"] },
    { "id": "s17-gei-dajia-jieshao", "hanzi": "大家好！我给大家介绍：这是米格。", "pinyin": "Dàjiā hǎo! Wǒ gěi dàjiā jièshào: zhè shì Mǐgé.", "english": "Hi, everyone! Let me introduce 米格.", "words": ["w-dajia", "w-hao", "w-wo", "w-gei", "w-dajia", "w-jieshao", "w-zhe", "w-shi", "w-mikkel"] },
    { "id": "s17-dajiahao-diyici", "hanzi": "大家好！这是我第一次来中国。", "pinyin": "Dàjiā hǎo! Zhè shì wǒ dìyī cì lái Zhōngguó.", "english": "Hi, everyone! This is my first time in China.", "words": ["w-dajia", "w-hao", "w-zhe", "w-shi", "w-wo", "w-diyi", "w-ci", "w-lai", "w-zhongguo"] },
    { "id": "s17-zhengzaixuexi-shuodehao", "hanzi": "他正在学习中文，说得很好！", "pinyin": "Tā zhèngzài xuéxí Zhōngwén, shuō de hěn hǎo!", "english": "He's learning Chinese, and he speaks it really well!", "words": ["w-ta-he", "w-zhengzai", "w-xuexi", "w-zhongwen", "w-shuo", "w-de-particle", "w-hen", "w-hao"] },
    { "id": "s17-ninguixing", "hanzi": "你贵姓？", "pinyin": "Nǐ guì xìng?", "english": "What's your surname?", "words": ["w-ni", "w-gui", "w-xing"] },
    { "id": "s17-woxingwang", "hanzi": "我姓王。", "pinyin": "Wǒ xìng Wáng.", "english": "My surname is Wang.", "words": ["w-wo", "w-xing", "w-wang-surname"] },
    { "id": "s17-wanglaoshi", "hanzi": "王老师，你好！", "pinyin": "Wáng lǎoshī, nǐ hǎo!", "english": "Hello, Teacher Wang!", "words": ["w-wang-surname", "w-laoshi", "w-ni", "w-hao"] }
