  "grammar": [
    { "id": "g17-de", "title": "说得很好: how well you do it", "body": "Verb + 得 + description says how well something is done: 说得很好 (speaks well), 说得不好 (doesn't speak well).\nWhen praised, people modestly answer 哪里哪里.", "examples": ["s17-shuodehenhao", "s17-nalinali"] },
    { "id": "g17-dong", "title": "听得懂, 听不懂", "body": "Put 得 or 不 between a verb and its result: 听得懂 (can understand), 听不懂 (can't understand). Say 听不懂 when you didn't catch what was said.", "examples": ["s17-tingdedongma", "s17-tingbudong"] },
    { "id": "g17-zhe", "title": "正在 and 着", "body": "正在 + verb: in the middle of doing it right now. 着 after a verb: an ongoing state, like 坐着 (sitting), 穿着 (wearing).", "examples": ["s17-babakanbaozhi", "s17-zuozhekanbaozhi", "s17-chuanzhehongyifu"] },
    { "id": "g17-wan", "title": "吃完了: finished", "body": "Verb + 完 means you finished doing it: 吃完了 (finished eating), 看完了 (finished reading or watching).", "examples": ["s17-chiwanle", "s17-kanwanshu"] },
    { "id": "g17-rang", "title": "让: let or make", "body": "让 + person + verb: let or make someone do something. 让我来吧! is a friendly \"let me do it\".", "examples": ["s17-rangwolai", "s17-mamarangwochi"] }
  ],
