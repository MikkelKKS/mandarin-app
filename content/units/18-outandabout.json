  "grammar": [
    { "id": "g18-transport", "title": "坐 and 骑", "body": "坐 for things you sit inside: 坐公共汽车, 坐船, 坐飞机. 骑 for things you sit astride: 骑自行车.\nThe vehicle comes before the verb of motion: 坐公共汽车去 (go by bus).", "examples": ["s18-zuogonggongqiche", "s18-qizixingche", "s18-zuochuanhenman"] },
    { "id": "g18-mei", "title": "每...都: every", "body": "每 + measure word + noun, usually with 都 before the verb: 每个周末都去游泳. 每天 needs no measure word.", "examples": ["s18-meigezhoumo", "s18-laolaotiaowu"] },
    { "id": "g18-ta", "title": "他, 她, 它 and 们", "body": "All three are tā: 他 (he), 她 (she), 它 (it, for animals and things). Add 们 for plural people: 他们, 你们, 我们.", "examples": ["s18-yizhimao-ta", "s18-tamenliangegehaizi"] },
    { "id": "g18-de-describe", "title": "穿红衣服的女人", "body": "A description + 的 goes before the noun: 穿红衣服的女人 (the woman wearing red). English puts it after; Chinese puts it before.", "examples": ["s18-chuanhongyifudenvren"] }
  ],
