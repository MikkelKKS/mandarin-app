  "sentences": [
    { "id": "s18-zuogonggongqiche", "hanzi": "我们坐公共汽车去吧。", "pinyin": "Wǒmen zuò gōnggòng qìchē qù ba.", "english": "Let's take the bus.", "words": ["w-women", "w-zuo", "w-gonggongqiche", "w-qu", "w-ba-particle"] },
    { "id": "s18-zuoyilu", "hanzi": "我坐一路公共汽车。", "pinyin": "Wǒ zuò yī lù gōnggòng qìchē.", "english": "I take the number 1 bus.", "words": ["w-wo", "w-zuo", "w-yi", "w-lu", "w-gonggongqiche"] },
    { "id": "s18-qizixingche", "hanzi": "我骑自行车去。", "pinyin": "Wǒ qí zìxíngchē qù.", "english": "I'll go by bike.", "words": ["w-wo", "w-qi-ride", "w-zixingche", "w-qu"] },
    { "id": "s18-zuochuanhenman", "hanzi": "坐船去很慢。", "pinyin": "Zuò chuán qù hěn màn.", "english": "Going by boat is slow.", "words": ["w-zuo", "w-chuan-boat", "w-qu", "w-hen", "w-man"] },
    { "id": "s18-luhenjin", "hanzi": "路很近，走路去吧。", "pinyin": "Lù hěn jìn, zǒulù qù ba.", "english": "It's close. Let's walk.", "words": ["w-lu", "w-hen", "w-jin-near", "w-zou", "w-lu", "w-qu", "w-ba-particle"] },
    { "id": "s18-chuquchifan", "hanzi": "我们出去吃饭吧。", "pinyin": "Wǒmen chūqù chīfàn ba.", "english": "Let's eat out.", "words": ["w-women", "w-chu", "w-qu", "w-chi", "w-fan", "w-ba-particle"] },
    { "id": "s18-chuquzouzou", "hanzi": "米格，咱们出去走走吧。", "pinyin": "Mǐgé, zánmen chūqù zǒuzou ba.", "english": "米格, let's go out for a walk.", "words": ["w-mikkel", "w-zanmen", "w-chu", "w-qu", "w-zou", "w-zou", "w-ba-particle"] },
    { "id": "s18-hao-zuoqiche", "hanzi": "好！坐公共汽车去吗？", "pinyin": "Hǎo! Zuò gōnggòng qìchē qù ma?", "english": "OK! Are we taking the bus?", "words": ["w-hao", "w-zuo", "w-gonggongqiche", "w-qu", "w-ma"] },
    { "id": "s18-kuaidian", "hanzi": "快点！", "pinyin": "Kuài diǎn!", "english": "Hurry up!", "words": ["w-kuai-fast", "w-dian"] },
    { "id": "s18-qichelaile", "hanzi": "公共汽车来了，快点！", "pinyin": "Gōnggòng qìchē lái le, kuài diǎn!", "english": "The bus is here, hurry!", "words": ["w-gonggongqiche", "w-lai", "w-le", "w-kuai-fast", "w-dian"] },
    { "id": "s18-woshiwaiguoren", "hanzi": "我是外国人。", "pinyin": "Wǒ shì wàiguó rén.", "english": "I'm a foreigner.", "words": ["w-wo", "w-shi", "w-wai", "w-guo", "w-ren"] },
    { "id": "s18-zaimenwaideng", "hanzi": "她在门外等你。", "pinyin": "Tā zài mén wài děng nǐ.", "english": "She's waiting for you outside the door.", "words": ["w-ta-she", "w-zai", "w-men-door", "w-wai", "w-deng", "w-ni"] },
    { "id": "s18-qingkaimen", "hanzi": "请开门！", "pinyin": "Qǐng kāi mén!", "english": "Please open the door!", "words": ["w-qing", "w-kai", "w-men-door"] },
    { "id": "s18-xiangwoxiao", "hanzi": "她向我笑了。", "pinyin": "Tā xiàng wǒ xiào le.", "english": "She smiled at me.", "words": ["w-ta-she", "w-xiang-toward", "w-wo", "w-xiao-laugh", "w-le"] },
    { "id": "s18-xiaoshenme", "hanzi": "你笑什么？", "pinyin": "Nǐ xiào shénme?", "english": "What are you laughing at?", "words": ["w-ni", "w-xiao-laugh", "w-shenme"] },
    { "id": "s18-tahengao", "hanzi": "他很高。", "pinyin": "Tā hěn gāo.", "english": "He's tall.", "words": ["w-ta-he", "w-hen", "w-gao"] },
    { "id": "s18-feichanggaoxing", "hanzi": "我非常高兴。", "pinyin": "Wǒ fēicháng gāoxìng.", "english": "I'm really happy.", "words": ["w-wo", "w-feichang", "w-gaoxing"] },
    { "id": "s18-weinigaoxing", "hanzi": "我为你高兴！", "pinyin": "Wǒ wèi nǐ gāoxìng!", "english": "I'm happy for you!", "words": ["w-wo", "w-wei-for", "w-ni", "w-gaoxing"] },
    { "id": "s18-tamenliangegehaizi", "hanzi": "他们有两个孩子。", "pinyin": "Tāmen yǒu liǎng ge háizi.", "english": "They have two children.", "words": ["w-ta-he", "w-men", "w-you", "w-liang", "w-ge", "w-haizi"] },
    { "id": "s18-nimenyouhaizima", "hanzi": "你们有孩子吗？", "pinyin": "Nǐmen yǒu háizi ma?", "english": "Do you have children?", "words": ["w-ni", "w-men", "w-you", "w-haizi", "w-ma"] },
