    { "id": "s18-nagenvren", "hanzi": "那个女人是我阿姨。", "pinyin": "Nà ge nǚrén shì wǒ āyí.", "english": "That woman is my aunt.", "words": ["w-na4", "w-ge", "w-nvren", "w-shi", "w-wo", "w-ayi"] },
    { "id": "s18-wangxianshengqizi", "hanzi": "王先生的妻子是老师。", "pinyin": "Wáng xiānsheng de qīzi shì lǎoshī.", "english": "Mr Wang's wife is a teacher.", "words": ["w-wang-surname", "w-xiansheng", "w-de", "w-qizi", "w-shi", "w-laoshi"] },
    { "id": "s18-tazhangfu", "hanzi": "她丈夫是医生。", "pinyin": "Tā zhàngfu shì yīshēng.", "english": "Her husband is a doctor.", "words": ["w-ta-she", "w-zhangfu", "w-shi", "w-yisheng"] },
    { "id": "s18-fuwuyuan-mifan", "hanzi": "服务员，来一碗米饭！", "pinyin": "Fúwùyuán, lái yì wǎn mǐfàn!", "english": "Excuse me, a bowl of rice please!", "words": ["w-fuwuyuan", "w-lai", "w-yi", "w-wan", "w-mifan"] },
    { "id": "s18-liangzhangpiao", "hanzi": "我买了两张票。", "pinyin": "Wǒ mǎi le liǎng zhāng piào.", "english": "I bought two tickets.", "words": ["w-wo", "w-mai3", "w-le", "w-liang", "w-zhang", "w-piao"] },
    { "id": "s18-meigezhoumo", "hanzi": "我每个周末都去游泳。", "pinyin": "Wǒ měi ge zhōumò dōu qù yóuyǒng.", "english": "I go swimming every weekend.", "words": ["w-wo", "w-mei-every", "w-ge", "w-zhoumo", "w-dou", "w-qu", "w-youyong"] },
    { "id": "s18-yizhimao-ta", "hanzi": "我们家有一只猫，它很小。", "pinyin": "Wǒmen jiā yǒu yì zhī māo, tā hěn xiǎo.", "english": "We have a cat. It's very small.", "words": ["w-women", "w-jia", "w-you", "w-yi", "w-zhi", "w-mao", "w-ta-it", "w-hen", "w-xiao"] },
    { "id": "s18-yijianshiqing", "hanzi": "我有一件事情要告诉你。", "pinyin": "Wǒ yǒu yí jiàn shìqing yào gàosu nǐ.", "english": "I have something to tell you.", "words": ["w-wo", "w-you", "w-yi", "w-jian-item", "w-shiqing", "w-yao", "w-gaosu", "w-ni"] },
    { "id": "s18-tizuqiu", "hanzi": "你喜欢踢足球吗？", "pinyin": "Nǐ xǐhuan tī zúqiú ma?", "english": "Do you like playing football?", "words": ["w-ni", "w-xihuan", "w-ti-kick", "w-zuqiu", "w-ma"] },
    { "id": "s18-laolaotiaowu", "hanzi": "姥姥每天晚上都去跳舞。", "pinyin": "Lǎolao měitiān wǎnshang dōu qù tiàowǔ.", "english": "Grandma goes dancing every evening.", "words": ["w-laolao", "w-meitian", "w-wanshang", "w-dou", "w-qu", "w-tiaowu"] },
