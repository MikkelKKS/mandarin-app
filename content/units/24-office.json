  "sentences": [
    { "id": "s24-zaiyinhanggongzuo", "hanzi": "她在银行工作。", "pinyin": "Tā zài yínháng gōngzuò.", "english": "She works at a bank.", "words": ["w-ta-she", "w-zai", "w-yinhang", "w-gongzuo"] },
    { "id": "s24-bangongshishiceng", "hanzi": "我的办公室在十层。", "pinyin": "Wǒ de bàngōngshì zài shí céng.", "english": "My office is on the tenth floor.", "words": ["w-wo", "w-de", "w-bangongshi", "w-zai", "w-shi2", "w-ceng"] },
    { "id": "s24-huiyihenzhongyao", "hanzi": "今天的会议很重要。", "pinyin": "Jīntiān de huìyì hěn zhòngyào.", "english": "Today's meeting is important.", "words": ["w-jintian", "w-de", "w-huiyi", "w-hen", "w-zhongyao"] },
    { "id": "s24-huiyijidianjieshu", "hanzi": "会议几点结束？", "pinyin": "Huìyì jǐ diǎn jiéshù?", "english": "What time does the meeting end?", "words": ["w-huiyi", "w-ji", "w-dian", "w-jieshu"] },
    { "id": "s24-sandianyike", "hanzi": "三点一刻结束。", "pinyin": "Sān diǎn yí kè jiéshù.", "english": "It ends at a quarter past three.", "words": ["w-san", "w-dian", "w-yi", "w-ke-quarter", "w-jieshu"] },
    { "id": "s24-badianyike", "hanzi": "现在八点一刻。", "pinyin": "Xiànzài bā diǎn yí kè.", "english": "It's a quarter past eight.", "words": ["w-xianzai", "w-ba", "w-dian", "w-yi", "w-ke-quarter"] },
    { "id": "s24-jingliyaoqiugao", "hanzi": "我们经理要求很高。", "pinyin": "Wǒmen jīnglǐ yāoqiú hěn gāo.", "english": "Our manager is very demanding.", "words": ["w-women", "w-jingli", "w-yaoqiu", "w-hen", "w-gao"] },
    { "id": "s24-tongshidouhenhao", "hanzi": "我的同事都很好。", "pinyin": "Wǒ de tóngshì dōu hěn hǎo.", "english": "My colleagues are all nice.", "words": ["w-wo", "w-de", "w-tongshi", "w-dou", "w-hen", "w-hao"] },
    { "id": "s24-jintiantailei", "hanzi": "今天太累了！", "pinyin": "Jīntiān tài lèi le!", "english": "Today was exhausting!", "words": ["w-jintian", "w-tai", "w-lei", "w-le"] },
    { "id": "s24-zenmele", "hanzi": "怎么了？", "pinyin": "Zěnme le?", "english": "What's wrong?", "words": ["w-zenme", "w-le"], "alt": { "english": ["What happened?"] } },
    { "id": "s24-huiyi-jingli", "hanzi": "今天的会议很重要，我们经理要求很高。", "pinyin": "Jīntiān de huìyì hěn zhòngyào, wǒmen jīnglǐ yāoqiú hěn gāo.", "english": "Today's meeting was important, and our manager is very demanding.", "words": ["w-jintian", "w-de", "w-huiyi", "w-hen", "w-zhongyao", "w-women", "w-jingli", "w-yaoqiu", "w-hen", "w-gao"] },
    { "id": "s24-xuyaobangmang", "hanzi": "你需要帮忙吗？", "pinyin": "Nǐ xūyào bāngmáng ma?", "english": "Do you need any help?", "words": ["w-ni", "w-xuyao", "w-bangmang", "w-ma"] },
    { "id": "s24-haimeijiejue", "hanzi": "有一个问题我还没解决。", "pinyin": "Yǒu yí ge wèntí wǒ hái méi jiějué.", "english": "There's one problem I still haven't solved.", "words": ["w-you", "w-yi", "w-ge", "w-wenti", "w-wo", "w-hai-still", "w-mei", "w-jiejue"] },
    { "id": "s24-zenmejiejue", "hanzi": "这个问题怎么解决？", "pinyin": "Zhège wèntí zěnme jiějué?", "english": "How do we solve this problem?", "words": ["w-zhe", "w-ge", "w-wenti", "w-zenme", "w-jiejue"] },
    { "id": "s24-yidingyoubanfa", "hanzi": "别担心，我们一定有办法。", "pinyin": "Bié dānxīn, wǒmen yídìng yǒu bànfǎ.", "english": "Don't worry, we'll find a way.", "words": ["w-bie", "w-danxin", "w-women", "w-yiding", "w-you", "w-banfa"] },
    { "id": "s24-meibanfa", "hanzi": "没办法。", "pinyin": "Méi bànfǎ.", "english": "Nothing we can do.", "words": ["w-mei", "w-banfa"], "alt": { "english": ["There's no way."] } },
    { "id": "s24-xiexie-zhenhao", "hanzi": "谢谢你！你真好。", "pinyin": "Xièxie nǐ! Nǐ zhēn hǎo.", "english": "Thank you! You're so kind.", "words": ["w-xiexie", "w-ni", "w-ni", "w-zhen", "w-hao"] },
    { "id": "s24-gongzuowanchengle", "hanzi": "今天的工作我完成了。", "pinyin": "Jīntiān de gōngzuò wǒ wánchéng le.", "english": "I've finished today's work.", "words": ["w-jintian", "w-de", "w-gongzuo", "w-wo", "w-wancheng", "w-le"] },
    { "id": "s24-juedingqubeijing", "hanzi": "我决定去北京工作。", "pinyin": "Wǒ juédìng qù Běijīng gōngzuò.", "english": "I've decided to work in Beijing.", "words": ["w-wo", "w-jueding", "w-qu", "w-beijing", "w-gongzuo"] },
    { "id": "s24-zhuyaoshi", "hanzi": "我学中文，主要是想跟她家人说话。", "pinyin": "Wǒ xué Zhōngwén, zhǔyào shì xiǎng gēn tā jiārén shuōhuà.", "english": "I'm learning Chinese mainly to talk with her family.", "words": ["w-wo", "w-xue", "w-zhongwen", "w-zhuyao", "w-shi", "w-xiang", "w-gen", "w-ta-she", "w-jia", "w-ren", "w-shuohua"] },
    { "id": "s24-haojihui", "hanzi": "这是一个很好的机会。", "pinyin": "Zhè shì yí ge hěn hǎo de jīhuì.", "english": "This is a great opportunity.", "words": ["w-zhe", "w-shi", "w-yi", "w-ge", "w-hen", "w-hao", "w-de", "w-jihui"] },
    { "id": "s24-xuanzenage", "hanzi": "你选择哪个？", "pinyin": "Nǐ xuǎnzé nǎ ge?", "english": "Which one do you choose?", "words": ["w-ni", "w-xuanze", "w-na3", "w-ge"] },
    { "id": "s24-jianchashenti", "hanzi": "医生给我检查身体。", "pinyin": "Yīshēng gěi wǒ jiǎnchá shēntǐ.", "english": "The doctor is giving me a check-up.", "words": ["w-yisheng", "w-gei", "w-wo", "w-jiancha", "w-shenti"] },
    { "id": "s24-fujinyinhang", "hanzi": "附近有银行吗？", "pinyin": "Fùjìn yǒu yínháng ma?", "english": "Is there a bank nearby?", "words": ["w-fujin", "w-you", "w-yinhang", "w-ma"] },
    { "id": "s24-yiwankuai", "hanzi": "这块手表一万块！", "pinyin": "Zhè kuài shǒubiǎo yíwàn kuài!", "english": "This watch costs ten thousand kuai!", "words": ["w-zhe", "w-kuai", "w-shoubiao", "w-yi", "w-wan-tenthousand", "w-kuai"] },
    { "id": "s24-jiezixingche", "hanzi": "我可以借你的自行车吗？", "pinyin": "Wǒ kěyǐ jiè nǐ de zìxíngchē ma?", "english": "Can I borrow your bike?", "words": ["w-wo", "w-keyi", "w-jie-borrow", "w-ni", "w-de", "w-zixingche", "w-ma"] },
    { "id": "s24-shifuquhuochezhan", "hanzi": "师傅，去火车站。", "pinyin": "Shīfu, qù huǒchēzhàn.", "english": "To the train station, please. (to a taxi driver)", "words": ["w-shifu", "w-qu", "w-huochezhan"] },
    { "id": "s24-tababa-siji", "hanzi": "他爸爸是出租车司机。", "pinyin": "Tā bàba shì chūzūchē sījī.", "english": "His dad is a taxi driver.", "words": ["w-ta-he", "w-baba", "w-shi", "w-chuzuche", "w-siji"] },
    { "id": "s24-shangwangkanxinwen", "hanzi": "我每天上网看新闻。", "pinyin": "Wǒ měitiān shàngwǎng kàn xīnwén.", "english": "I read the news online every day.", "words": ["w-wo", "w-meitian", "w-shangwang", "w-kan", "w-xinwen"] },
    { "id": "s24-dianzishu", "hanzi": "我喜欢看电子书。", "pinyin": "Wǒ xǐhuan kàn diànzǐ shū.", "english": "I like reading e-books.", "words": ["w-wo", "w-xihuan", "w-kan", "w-dianzi", "w-shu"] },
    { "id": "s24-laoyexiexin", "hanzi": "姥爷还在写信。", "pinyin": "Lǎoye hái zài xiě xìn.", "english": "Grandpa still writes letters.", "words": ["w-laoye", "w-hai-still", "w-zai", "w-xie-write", "w-xin-letter"] }
  ],
