  "grammar": [
    { "id": "g24-ke", "title": "一刻: a quarter", "body": "一刻 is a quarter of an hour: 八点一刻 (8:15). 三刻 is 45 minutes, but 八点四十五 is more common. 半 is half: 八点半.", "examples": ["s24-badianyike", "s24-sandianyike"] },
    { "id": "g24-banfa", "title": "有办法, 没办法", "body": "办法 is a way to deal with something. 有办法: there's a way. 没办法: nothing can be done, a very common sigh.", "examples": ["s24-yidingyoubanfa", "s24-meibanfa"] },
    { "id": "g24-shifu", "title": "师傅 for drivers and workers", "body": "In Beijing, call a taxi driver, a cook or a repair worker 师傅. Just say 师傅, then where you're going: 师傅，去火车站.", "examples": ["s24-shifuquhuochezhan"] },
    { "id": "g24-wan", "title": "万: ten thousand", "body": "Chinese counts big numbers in ten-thousands: 一万 (10,000), 十万 (100,000). So 20,000 is 两万, not \"twenty thousand\".", "examples": ["s24-yiwankuai"] }
  ],
