    { "id": "x-welcome", "prompt": "s-huanying-qingjin", "reply": "s-xiexie", "wrong": ["s-zaijian", "s-nishinaguoren"], "context": "You arrive at someone's home." }
  ],
  "grammar": [
    { "id": "g-jiao", "title": "Names with 叫", "body": "我叫 + name = my name is…\nTo ask, put 什么 (what) where the answer would go: 你叫什么名字？ Chinese question words stay in the same place as the answer. No moving words to the front like in English or Danish.", "examples": ["s-nijiaoshenmemingzi", "s-wojiaomikkel"] },
    { "id": "g-guoren", "title": "Country + 人 = nationality", "body": "Add 人 (person) after a country: 中国人 = Chinese person, 丹麦人 = Dane. To ask: 你是哪国人？ (you are which-country person?)", "examples": ["s-woshidanmairen", "s-nishinaguoren"] },
    { "id": "g-hui", "title": "会 for skills you've learned", "body": "会 + verb = can / know how to. 我会说一点 = I can speak a little. Make a question with 吗.", "examples": ["s-wohuishuoyidian", "s-nihuishuozhongwenma"] },
    { "id": "g-de", "title": "的 = 's", "body": "的 links an owner to a thing: 你的中文 = your Chinese, 我的名字 = my name.", "examples": ["s-nidezhongwenhenhao"] },
    { "id": "g-nin", "title": "Polite 您", "body": "您 (nín) is a respectful 'you'. Use it with a partner's parents and other elders, especially the first time you meet.", "examples": ["s-ninhao"] }
  ],
