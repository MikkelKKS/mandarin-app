  "sentences": [
    { "id": "s-nijiaoshenmemingzi", "hanzi": "你叫什么名字？", "pinyin": "Nǐ jiào shénme míngzi?", "english": "What's your name?", "words": ["w-ni", "w-jiao", "w-shenme", "w-mingzi"], "alt": { "pinyin": ["nǐ jiào shénme"] } },
    { "id": "s-wojiaomikkel", "hanzi": "我叫米格。", "pinyin": "Wǒ jiào Mǐgé.", "english": "My name is Mikkel.", "words": ["w-wo", "w-jiao", "w-mikkel"], "alt": { "english": ["I'm called Mikkel.", "I'm Mikkel."] } },
    { "id": "s-ninhao-wojiao", "hanzi": "您好！我叫米格。", "pinyin": "Nín hǎo! Wǒ jiào Mǐgé.", "english": "Hello! My name is Mikkel.", "words": ["w-nin", "w-hao", "w-wo", "w-jiao", "w-mikkel"] },
    { "id": "s-ninhao", "hanzi": "您好！", "pinyin": "Nín hǎo!", "english": "Hello! (polite)", "words": ["w-nin", "w-hao"] },
    { "id": "s-renshinihengaoxing", "hanzi": "认识你很高兴！", "pinyin": "Rènshi nǐ hěn gāoxìng!", "english": "Nice to meet you!", "words": ["w-renshi", "w-ni", "w-hen", "w-gaoxing"], "alt": { "english": ["Pleased to meet you!"] } },
    { "id": "s-nihao-mikkel-renshi", "hanzi": "你好，米格！认识你很高兴！", "pinyin": "Nǐ hǎo, Mǐgé! Rènshi nǐ hěn gāoxìng!", "english": "Hello, Mikkel! Nice to meet you!", "words": ["w-nihao", "w-mikkel", "w-renshi", "w-ni", "w-hen", "w-gaoxing"] },
    { "id": "s-woyehengaoxing", "hanzi": "我也很高兴。", "pinyin": "Wǒ yě hěn gāoxìng.", "english": "Nice to meet you too.", "words": ["w-wo", "w-ye", "w-hen", "w-gaoxing"], "alt": { "english": ["I'm glad too.", "Me too."] } },
    { "id": "s-zheshimikkel", "hanzi": "这是米格。", "pinyin": "Zhè shì Mǐgé.", "english": "This is Mikkel.", "words": ["w-zhe", "w-shi", "w-mikkel"] },
    { "id": "s-nishinaguoren", "hanzi": "你是哪国人？", "pinyin": "Nǐ shì nǎ guó rén?", "english": "Where are you from?", "words": ["w-ni", "w-shi", "w-na3", "w-guo", "w-ren"], "alt": { "english": ["Which country are you from?"] } },
    { "id": "s-woshidanmairen", "hanzi": "我是丹麦人。", "pinyin": "Wǒ shì Dānmài rén.", "english": "I'm Danish.", "words": ["w-wo", "w-shi", "w-danmai", "w-ren"], "alt": { "english": ["I'm from Denmark."] } },
    { "id": "s-tashizhongguoren", "hanzi": "她是中国人。", "pinyin": "Tā shì Zhōngguó rén.", "english": "She's Chinese.", "words": ["w-ta-she", "w-shi", "w-zhongguo", "w-ren"] },
    { "id": "s-tabushizhongguoren", "hanzi": "他不是中国人。", "pinyin": "Tā bú shì Zhōngguó rén.", "english": "He isn't Chinese.", "words": ["w-ta-he", "w-bu", "w-shi", "w-zhongguo", "w-ren"] },
    { "id": "s-nihuishuozhongwenma", "hanzi": "你会说中文吗？", "pinyin": "Nǐ huì shuō Zhōngwén ma?", "english": "Can you speak Chinese?", "words": ["w-ni", "w-hui", "w-shuo", "w-zhongwen", "w-ma"], "alt": { "english": ["Do you speak Chinese?"] } },
    { "id": "s-wohuishuoyidian", "hanzi": "我会说一点。", "pinyin": "Wǒ huì shuō yìdiǎn.", "english": "I can speak a little.", "words": ["w-wo", "w-hui", "w-shuo", "w-yidian"] },
    { "id": "s-wozaixuezhongwen", "hanzi": "我在学中文。", "pinyin": "Wǒ zài xué Zhōngwén.", "english": "I'm learning Chinese.", "words": ["w-wo", "w-zai", "w-xue", "w-zhongwen"] },
    { "id": "s-huishuoyidian-zaixue", "hanzi": "我会说一点。我在学中文。", "pinyin": "Wǒ huì shuō yìdiǎn. Wǒ zài xué Zhōngwén.", "english": "I can speak a little. I'm learning Chinese.", "words": ["w-wo", "w-hui", "w-shuo", "w-yidian", "w-wo", "w-zai", "w-xue", "w-zhongwen"] },
    { "id": "s-tahuishuohanyu", "hanzi": "他会说汉语。", "pinyin": "Tā huì shuō Hànyǔ.", "english": "He can speak Chinese.", "words": ["w-ta-he", "w-hui", "w-shuo", "w-hanyu"] },
    { "id": "s-nidezhongwenhenhao", "hanzi": "你的中文很好！", "pinyin": "Nǐ de Zhōngwén hěn hǎo!", "english": "Your Chinese is very good!", "words": ["w-ni", "w-de", "w-zhongwen", "w-hen", "w-hao"] },
    { "id": "s-nalinali", "hanzi": "哪里哪里！", "pinyin": "Nǎlǐ nǎlǐ!", "english": "Oh, not really!", "words": ["w-nali", "w-nali"], "alt": { "english": ["Not at all!"] } },
    { "id": "s-huanying", "hanzi": "欢迎欢迎！", "pinyin": "Huānyíng huānyíng!", "english": "Welcome!", "words": ["w-huanying", "w-huanying"] },
    { "id": "s-huanying-qingjin", "hanzi": "欢迎欢迎！请进！", "pinyin": "Huānyíng huānyíng! Qǐng jìn!", "english": "Welcome! Come in!", "words": ["w-huanying", "w-huanying", "w-qing", "w-jin"] },
    { "id": "s-qingjin", "hanzi": "请进！", "pinyin": "Qǐng jìn!", "english": "Come in, please!", "words": ["w-qing", "w-jin"] },
    { "id": "s-qingzuo", "hanzi": "请坐。", "pinyin": "Qǐng zuò.", "english": "Please sit down.", "words": ["w-qing", "w-zuo"], "alt": { "english": ["Have a seat."] } },
    { "id": "s-qingzuo-huishuo", "hanzi": "请坐。你会说中文吗？", "pinyin": "Qǐng zuò. Nǐ huì shuō Zhōngwén ma?", "english": "Have a seat. Can you speak Chinese?", "words": ["w-qing", "w-zuo", "w-ni", "w-hui", "w-shuo", "w-zhongwen", "w-ma"] },
    { "id": "s-xiexie", "hanzi": "谢谢！", "pinyin": "Xièxie!", "english": "Thanks!", "words": ["w-xiexie"], "alt": { "english": ["Thank you!"] } }
