  "sentences": [
    { "id": "s20-xiaoshihouzhaopian", "hanzi": "米格，你看，这是她小时候的照片。", "pinyin": "Mǐgé, nǐ kàn, zhè shì tā xiǎo shíhou de zhàopiàn.", "english": "米格, look, this is a photo of her as a child.", "words": ["w-mikkel", "w-ni", "w-kan", "w-zhe", "w-shi", "w-ta-she", "w-xiao", "w-shihou", "w-de", "w-zhaopian"] },
    { "id": "s20-xiaoshihoukeai", "hanzi": "她小时候真可爱！", "pinyin": "Tā xiǎo shíhou zhēn kě'ài!", "english": "She was so cute as a child!", "words": ["w-ta-she", "w-xiao", "w-shihou", "w-zhen", "w-keai"] },
    { "id": "s20-xiangmama", "hanzi": "她很像她妈妈。", "pinyin": "Tā hěn xiàng tā māma.", "english": "She looks a lot like her mum.", "words": ["w-ta-she", "w-hen", "w-xiang-like", "w-ta-she", "w-mama"] },
    { "id": "s20-yanjingbizi", "hanzi": "她的眼睛像她爸爸，鼻子像我。", "pinyin": "Tā de yǎnjing xiàng tā bàba, bízi xiàng wǒ.", "english": "She has her dad's eyes and my nose.", "words": ["w-ta-she", "w-de", "w-yanjing", "w-xiang-like", "w-ta-she", "w-baba", "w-bizi", "w-xiang-like", "w-wo"] },
    { "id": "s20-toufahenchang", "hanzi": "她头发很长。", "pinyin": "Tā tóufa hěn cháng.", "english": "She has long hair.", "words": ["w-ta-she", "w-toufa", "w-hen", "w-chang-long"] },
    { "id": "s20-lianhongle", "hanzi": "她脸红了。", "pinyin": "Tā liǎn hóng le.", "english": "She blushed.", "words": ["w-ta-she", "w-lian", "w-hong", "w-le"] },
    { "id": "s20-erduoteng", "hanzi": "太冷了，我的耳朵很疼！", "pinyin": "Tài lěng le, wǒ de ěrduo hěn téng!", "english": "It's so cold my ears hurt!", "words": ["w-tai", "w-leng", "w-le", "w-wo", "w-de", "w-erduo", "w-hen", "w-teng"] },
    { "id": "s20-jiaoteng", "hanzi": "我的脚很疼。", "pinyin": "Wǒ de jiǎo hěn téng.", "english": "My feet hurt.", "words": ["w-wo", "w-de", "w-jiao-foot", "w-hen", "w-teng"] },
    { "id": "s20-tuihenlei", "hanzi": "走了一天，腿很累。", "pinyin": "Zǒu le yì tiān, tuǐ hěn lèi.", "english": "We walked all day. My legs are tired.", "words": ["w-zou", "w-le", "w-yi", "w-tian", "w-tui", "w-hen", "w-lei"] },
    { "id": "s20-nvercongming", "hanzi": "你的女儿很聪明。", "pinyin": "Nǐ de nǚ'ér hěn cōngming.", "english": "Your daughter is very clever.", "words": ["w-ni", "w-de", "w-nver", "w-hen", "w-congming"] },
    { "id": "s20-nipangle", "hanzi": "你胖了！", "pinyin": "Nǐ pàng le!", "english": "You've put on weight!", "words": ["w-ni", "w-pang", "w-le"] },
    { "id": "s20-nishoule", "hanzi": "你瘦了！", "pinyin": "Nǐ shòu le!", "english": "You've lost weight!", "words": ["w-ni", "w-shou", "w-le"] },
    { "id": "s20-nashihouhenshou", "hanzi": "对，那时候他很瘦！", "pinyin": "Duì, nà shíhou tā hěn shòu!", "english": "Yes, he was so thin back then!", "words": ["w-dui", "w-na4", "w-shihou", "w-ta-he", "w-hen", "w-shou"] },
    { "id": "s20-bigegeai", "hanzi": "我比我哥哥矮。", "pinyin": "Wǒ bǐ wǒ gēge ǎi.", "english": "I'm shorter than my older brother.", "words": ["w-wo", "w-bi", "w-wo", "w-gege", "w-ai-short"] },
    { "id": "s20-gaoai", "hanzi": "米格很高，姥姥很矮。", "pinyin": "Mǐgé hěn gāo, lǎolao hěn ǎi.", "english": "米格 is tall and Grandma is short.", "words": ["w-mikkel", "w-hen", "w-gao", "w-laolao", "w-hen", "w-ai-short"] },
    { "id": "s20-ninzhennianqing", "hanzi": "你真年轻！", "pinyin": "Nǐ zhēn niánqīng!", "english": "You look so young!", "words": ["w-ni", "w-zhen", "w-nianqing"] },
    { "id": "s20-xianzaiyenianqing", "hanzi": "妈，你现在也很年轻！", "pinyin": "Mā, nǐ xiànzài yě hěn niánqīng!", "english": "Mum, you still look young!", "words": ["w-ma-mum", "w-ni", "w-xianzai", "w-ye", "w-hen", "w-nianqing"] },
