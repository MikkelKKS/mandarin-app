    { "id": "g20-measures", "title": "Measure words for clothes", "body": "件 for tops and coats (一件衬衫), 条 for long things like trousers and skirts (一条裤子), 双 for pairs (一双鞋).", "examples": ["s20-huangchenshan", "s20-kuzitaichang", "s20-yishuangxie"] },
    { "id": "g20-dai", "title": "穿 or 戴?", "body": "穿 for clothes and shoes. 戴 for things you put on: hats, glasses, watches.", "examples": ["s20-daimaozi", "s20-lanchenshan"] },
    { "id": "g20-pang", "title": "你胖了! is small talk", "body": "Relatives often greet you with 你胖了 (you've gained weight) or 你瘦了 (you've lost weight). It's friendly concern, not rude. Smile and say something about the good food.", "examples": ["s20-nipangle", "s20-nishoule"] }
