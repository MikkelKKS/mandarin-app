    { "id": "s20-huangchenshan", "hanzi": "这件黄衬衫很漂亮。", "pinyin": "Zhè jiàn huáng chènshān hěn piàoliang.", "english": "This yellow shirt is lovely.", "words": ["w-zhe", "w-jian-item", "w-huang", "w-chenshan", "w-hen", "w-piaoliang"] },
