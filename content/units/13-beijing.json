  "grammar": [
    { "id": "g-erhua", "title": "The Beijing -r (儿化)", "body": "Beijingers add an r to many words: 哪儿 nǎr (= 哪里), 这儿 zhèr, 那儿 nàr, 一会儿 yíhuìr, 玩儿 wánr. The 儿 isn't a separate syllable; it curls the end of the one before. When you type, nǎr and nǎ are both accepted.", "examples": ["s-niqunar", "s-wozaizherne", "s-dengyihuir"] },
    { "id": "g-zanmen", "title": "咱们 vs 我们", "body": "咱们 means 'we, including you'. Beijingers use it all the time for suggestions: 咱们去遛弯儿吧. 我们 can leave the listener out.", "examples": ["s-zanmenquliuwanr", "s-zanmenyiqichifan"] },
    { "id": "g-chilema", "title": "您吃了吗？", "body": "A classic way to say hello, especially from older people. It isn't an invitation: just answer 吃了 and ask back. Beijingers also use 您 a lot with elders.", "examples": ["s-ninchilema", "s-chile-ninne"] },
    { "id": "g-grandparents", "title": "Grandparents", "body": "In the north, your mum's parents are 姥姥 (grandma) and 姥爷 (grandpa). Your dad's parents are 奶奶 and 爷爷. In the south people say 外婆 and 外公.", "examples": ["s-laolaohao", "s-laoye-ninhao"] },
    { "id": "g-bjwords", "title": "Beijing words", "body": "甭 = 不用 (甭客气 = don't mention it). 得嘞 = you got it. 倍儿 = super (倍儿好). 地道 = authentic. 慢走 = take care, said to a guest who's leaving.", "examples": ["s-bengkeqi", "s-delei", "s-ninmanzou"] }
  ],
