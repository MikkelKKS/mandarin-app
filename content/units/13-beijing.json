  "sentences": [
    { "id": "s-ninchilema", "hanzi": "您吃了吗？", "pinyin": "Nín chī le ma?", "english": "Have you eaten? (a greeting)", "words": ["w-nin", "w-chi", "w-le", "w-ma"] },
    { "id": "s-chile-ninne", "hanzi": "吃了，您呢？", "pinyin": "Chī le, nín ne?", "english": "Yes, I have. And you?", "words": ["w-chi", "w-le", "w-nin", "w-ne"] },
    { "id": "s-mige-chilema", "hanzi": "米格，你吃了吗？", "pinyin": "Mǐgé, nǐ chī le ma?", "english": "米格, have you eaten?", "words": ["w-mikkel", "w-ni", "w-chi", "w-le", "w-ma"] },
    { "id": "s-chile-laolao", "hanzi": "吃了，姥姥您呢？", "pinyin": "Chī le, lǎolao nín ne?", "english": "Yes, Grandma. Have you?", "words": ["w-chi", "w-le", "w-laolao", "w-nin", "w-ne"] },
    { "id": "s-niqunar", "hanzi": "你去哪儿？", "pinyin": "Nǐ qù nǎr?", "english": "Where are you going?", "words": ["w-ni", "w-qu", "w-nar"], "alt": { "pinyin": ["Nǐ qù nǎlǐ?"] } },
    { "id": "s-woquliuwanr", "hanzi": "我去遛弯儿。", "pinyin": "Wǒ qù liùwānr.", "english": "I'm going for a stroll.", "words": ["w-wo", "w-qu", "w-liuwanr"] },
    { "id": "s-zanmenquliuwanr", "hanzi": "咱们去遛弯儿吧。", "pinyin": "Zánmen qù liùwānr ba.", "english": "Let's go for a stroll.", "words": ["w-zanmen", "w-qu", "w-liuwanr", "w-ba-particle"] },
    { "id": "s-yechile-liuwanr", "hanzi": "我也吃了。咱们去遛弯儿吧！", "pinyin": "Wǒ yě chī le. Zánmen qù liùwānr ba!", "english": "Me too. Let's go for a stroll!", "words": ["w-wo", "w-ye", "w-chi", "w-le", "w-zanmen", "w-qu", "w-liuwanr", "w-ba-particle"] },
    { "id": "s-wozaizherne", "hanzi": "我在这儿呢。", "pinyin": "Wǒ zài zhèr ne.", "english": "I'm over here.", "words": ["w-wo", "w-zai", "w-zher", "w-ne"] },
    { "id": "s-tazainar", "hanzi": "他在那儿。", "pinyin": "Tā zài nàr.", "english": "He's over there.", "words": ["w-ta-he", "w-zai", "w-nar4"] },
    { "id": "s-dengyihuir", "hanzi": "等一会儿。", "pinyin": "Děng yíhuìr.", "english": "Wait a moment.", "words": ["w-deng", "w-yihuir"] },
    { "id": "s-zherzhenhaowanr", "hanzi": "这儿真好玩儿！", "pinyin": "Zhèr zhēn hǎowánr!", "english": "It's so much fun here!", "words": ["w-zher", "w-zhen", "w-haowanr"] },
    { "id": "s-meishir", "hanzi": "没事儿。", "pinyin": "Méishìr.", "english": "No worries.", "words": ["w-meishir"], "alt": { "english": ["It's nothing.", "I'm fine."] } },
    { "id": "s-caihendidao", "hanzi": "这个菜很地道。", "pinyin": "Zhège cài hěn dìdao.", "english": "This dish is really authentic.", "words": ["w-zhe", "w-ge", "w-cai", "w-hen", "w-didao"] },
    { "id": "s-bengkeqi", "hanzi": "甭客气！", "pinyin": "Béng kèqi!", "english": "Don't mention it!", "words": ["w-beng", "w-keqi"] },
    { "id": "s-delei", "hanzi": "得嘞！", "pinyin": "Dé lei!", "english": "You got it!", "words": ["w-delei"], "alt": { "english": ["Righto!"] } },
    { "id": "s-xihuanhutong", "hanzi": "我很喜欢胡同。", "pinyin": "Wǒ hěn xǐhuan hútòng.", "english": "I really like the hutongs.", "words": ["w-wo", "w-hen", "w-xihuan", "w-hutong"] },
    { "id": "s-zhershiwomendehutong", "hanzi": "你看，这儿就是我们的胡同。", "pinyin": "Nǐ kàn, zhèr jiù shì wǒmen de hútòng.", "english": "Look, this is our hutong.", "words": ["w-ni", "w-kan", "w-zher", "w-jiu-just", "w-shi", "w-women", "w-de", "w-hutong"] },
    { "id": "s-zanmenyiqichifan", "hanzi": "咱们一起吃饭吧。", "pinyin": "Zánmen yìqǐ chīfàn ba.", "english": "Let's eat together.", "words": ["w-zanmen", "w-yiqi", "w-chi", "w-fan", "w-ba-particle"] },
    { "id": "s-laolaohao", "hanzi": "姥姥好！", "pinyin": "Lǎolao hǎo!", "english": "Hello, Grandma!", "words": ["w-laolao", "w-hao"] },
    { "id": "s-laoye-ninhao", "hanzi": "姥爷，您好！", "pinyin": "Lǎoye, nín hǎo!", "english": "Hello, Grandpa!", "words": ["w-laoye", "w-nin", "w-hao"] },
    { "id": "s-wozoule", "hanzi": "我走了。", "pinyin": "Wǒ zǒu le.", "english": "I'm off now.", "words": ["w-wo", "w-zou", "w-le"] },
    { "id": "s-ninmanzou", "hanzi": "您慢走！", "pinyin": "Nín màn zǒu!", "english": "Take care!", "words": ["w-nin", "w-manzou"] },
    { "id": "s-leibulei-zuo", "hanzi": "累不累？咱们坐一会儿吧。", "pinyin": "Lèi bu lèi? Zánmen zuò yíhuìr ba.", "english": "Tired? Let's sit for a bit.", "words": ["w-lei", "w-bu", "w-lei", "w-zanmen", "w-zuo", "w-yihuir", "w-ba-particle"] },
    { "id": "s-meishir-beirhao", "hanzi": "没事儿，我倍儿好！", "pinyin": "Méishìr, wǒ bèir hǎo!", "english": "No worries, I feel great!", "words": ["w-meishir", "w-wo", "w-beir", "w-hao"] }
