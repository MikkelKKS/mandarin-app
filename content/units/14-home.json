  "sentences": [
    { "id": "s14-beizizaizhuozishang", "hanzi": "杯子在桌子上。", "pinyin": "Bēizi zài zhuōzi shàng.", "english": "The cup is on the table.", "words": ["w-beizi", "w-zai", "w-zhuozi", "w-shang"] },
    { "id": "s14-zaizhuozishang", "hanzi": "在桌子上。", "pinyin": "Zài zhuōzi shàng.", "english": "On the table.", "words": ["w-zai", "w-zhuozi", "w-shang"], "alt": { "english": ["It's on the table."] } },
    { "id": "s14-beiziliyoucha", "hanzi": "杯子里有茶。", "pinyin": "Bēizi lǐ yǒu chá.", "english": "There's tea in the cup.", "words": ["w-beizi", "w-li-inside", "w-you", "w-cha"] },
    { "id": "s14-jialiyouhenduodongxi", "hanzi": "家里有很多东西。", "pinyin": "Jiā lǐ yǒu hěn duō dōngxi.", "english": "There's a lot of stuff at home.", "words": ["w-jia", "w-li-inside", "w-you", "w-hen", "w-duo", "w-dongxi"] },
    { "id": "s14-maidiandongxi", "hanzi": "我们去买点东西吧。", "pinyin": "Wǒmen qù mǎi diǎn dōngxi ba.", "english": "Let's go and buy a few things.", "words": ["w-women", "w-qu", "w-mai3", "w-dian", "w-dongxi", "w-ba-particle"] },
    { "id": "s14-kanjianshoujilema", "hanzi": "你看见我的手机了吗？", "pinyin": "Nǐ kànjiàn wǒ de shǒujī le ma?", "english": "Have you seen my phone?", "words": ["w-ni", "w-kanjian", "w-wo", "w-de", "w-shouji", "w-le", "w-ma"] },
    { "id": "s14-ayi-kanjian", "hanzi": "阿姨，您看见我的手机了吗？", "pinyin": "Āyí, nín kànjiàn wǒ de shǒujī le ma?", "english": "Auntie, have you seen my phone?", "words": ["w-ayi", "w-nin", "w-kanjian", "w-wo", "w-de", "w-shouji", "w-le", "w-ma"] },
    { "id": "s14-meikanjian", "hanzi": "没看见。", "pinyin": "Méi kànjiàn.", "english": "I haven't seen it.", "words": ["w-mei", "w-kanjian"], "alt": { "english": ["No, I haven't."] } },
    { "id": "s14-meikanjian-zhuozi", "hanzi": "没看见。在桌子上吗？", "pinyin": "Méi kànjiàn. Zài zhuōzi shàng ma?", "english": "I haven't seen it. Is it on the table?", "words": ["w-mei", "w-kanjian", "w-zai", "w-zhuozi", "w-shang", "w-ma"] },
    { "id": "s14-zhuozishangmeiyou", "hanzi": "桌子上没有。", "pinyin": "Zhuōzi shàng méiyǒu.", "english": "It's not on the table.", "words": ["w-zhuozi", "w-shang", "w-mei", "w-you"] },
    { "id": "s14-zaizhuozihoumian", "hanzi": "在桌子后面。", "pinyin": "Zài zhuōzi hòumiàn.", "english": "Behind the table.", "words": ["w-zai", "w-zhuozi", "w-houmian"] },
    { "id": "s14-maozaiyizishang", "hanzi": "猫在椅子上睡觉。", "pinyin": "Māo zài yǐzi shàng shuìjiào.", "english": "The cat is sleeping on the chair.", "words": ["w-mao", "w-zai", "w-yizi", "w-shang", "w-shuijiao"] },
    { "id": "s14-shoujizaimaohoumian", "hanzi": "你看，猫在椅子上睡觉。手机在猫后面！", "pinyin": "Nǐ kàn, māo zài yǐzi shàng shuìjiào. Shǒujī zài māo hòumiàn!", "english": "Look, the cat is sleeping on the chair. The phone is behind the cat!", "words": ["w-ni", "w-kan", "w-mao", "w-zai", "w-yizi", "w-shang", "w-shuijiao", "w-shouji", "w-zai", "w-mao", "w-houmian"] },
    { "id": "s14-zhexiedongxi", "hanzi": "这些东西是你的吗？", "pinyin": "Zhèxiē dōngxi shì nǐ de ma?", "english": "Are these things yours?", "words": ["w-zhe", "w-xie", "w-dongxi", "w-shi", "w-ni", "w-de", "w-ma"] },
    { "id": "s14-xiaomao", "hanzi": "这只小猫很漂亮。", "pinyin": "Zhè zhī xiǎo māo hěn piàoliang.", "english": "This kitten is very pretty.", "words": ["w-zhe", "w-zhi", "w-xiao", "w-mao", "w-hen", "w-piaoliang"] },
    { "id": "s14-beizitaixiao", "hanzi": "这个杯子太小了。", "pinyin": "Zhège bēizi tài xiǎo le.", "english": "This cup is too small.", "words": ["w-zhe", "w-ge", "w-beizi", "w-tai", "w-xiao", "w-le"] },
    { "id": "s14-xiangshuijiao", "hanzi": "我想睡觉了。", "pinyin": "Wǒ xiǎng shuìjiào le.", "english": "I want to go to bed.", "words": ["w-wo", "w-xiang", "w-shuijiao", "w-le"], "alt": { "english": ["I'm ready for bed."] } },
    { "id": "s14-jidianshuijiao", "hanzi": "你几点睡觉？", "pinyin": "Nǐ jǐ diǎn shuìjiào?", "english": "What time do you go to bed?", "words": ["w-ni", "w-ji", "w-dian", "w-shuijiao"] },
    { "id": "s14-wanshangshidian", "hanzi": "晚上十点。", "pinyin": "Wǎnshang shí diǎn.", "english": "Ten in the evening.", "words": ["w-wanshang", "w-shi2", "w-dian"], "alt": { "english": ["10 pm."] } },
    { "id": "s14-erzinver", "hanzi": "我姐姐有一个儿子和一个女儿。", "pinyin": "Wǒ jiějie yǒu yí ge érzi hé yí ge nǚ'ér.", "english": "My older sister has a son and a daughter.", "words": ["w-wo", "w-jiejie", "w-you", "w-yi", "w-ge", "w-erzi", "w-he", "w-yi", "w-ge", "w-nver"] },
    { "id": "s14-nversansui", "hanzi": "她女儿三岁了。", "pinyin": "Tā nǚ'ér sān suì le.", "english": "Her daughter is three.", "words": ["w-ta-she", "w-nver", "w-san", "w-sui", "w-le"] },
    { "id": "s14-erzijiaoshenme", "hanzi": "您儿子叫什么名字？", "pinyin": "Nín érzi jiào shénme míngzi?", "english": "What's your son's name?", "words": ["w-nin", "w-erzi", "w-jiao", "w-shenme", "w-mingzi"] },
    { "id": "s14-woaini", "hanzi": "我爱你。", "pinyin": "Wǒ ài nǐ.", "english": "I love you.", "words": ["w-wo", "w-ai", "w-ni"] },
    { "id": "s14-aichijiaozi", "hanzi": "她很爱吃饺子。", "pinyin": "Tā hěn ài chī jiǎozi.", "english": "She loves eating dumplings.", "words": ["w-ta-she", "w-hen", "w-ai", "w-chi", "w-jiaozi"] },
    { "id": "s14-chimifanma", "hanzi": "你吃米饭吗？", "pinyin": "Nǐ chī mǐfàn ma?", "english": "Would you like some rice?", "words": ["w-ni", "w-chi", "w-mifan", "w-ma"], "alt": { "english": ["Do you eat rice?"] } },
    { "id": "s14-yaoyidian", "hanzi": "要一点，谢谢。", "pinyin": "Yào yìdiǎn, xièxie.", "english": "Just a little, thanks.", "words": ["w-yao", "w-yidian", "w-xiexie"] },
    { "id": "s14-chitaishaole", "hanzi": "你吃太少了！", "pinyin": "Nǐ chī tài shǎo le!", "english": "You're eating too little!", "words": ["w-ni", "w-chi", "w-tai", "w-shao", "w-le"] },
    { "id": "s14-baole-xiexieayi", "hanzi": "我饱了，谢谢阿姨。", "pinyin": "Wǒ bǎo le, xièxie āyí.", "english": "I'm full, thank you, Auntie.", "words": ["w-wo", "w-bao", "w-le", "w-xiexie", "w-ayi"] },
    { "id": "s14-renduorenshao", "hanzi": "中国人很多，丹麦人很少。", "pinyin": "Zhōngguó rén hěn duō, Dānmài rén hěn shǎo.", "english": "There are lots of Chinese people and very few Danes.", "words": ["w-zhongguo", "w-ren", "w-hen", "w-duo", "w-danmai", "w-ren", "w-hen", "w-shao"] },
    { "id": "s14-shangdianjidiankai", "hanzi": "商店几点开？", "pinyin": "Shāngdiàn jǐ diǎn kāi?", "english": "What time does the shop open?", "words": ["w-shangdian", "w-ji", "w-dian", "w-kai"] },
    { "id": "s14-jiudiankai", "hanzi": "九点开。", "pinyin": "Jiǔ diǎn kāi.", "english": "It opens at nine.", "words": ["w-jiu", "w-dian", "w-kai"] },
    { "id": "s14-taihaole-xiexie", "hanzi": "太好了！谢谢阿姨！", "pinyin": "Tài hǎo le! Xièxie āyí!", "english": "Great! Thank you, Auntie!", "words": ["w-tai", "w-hao", "w-le", "w-xiexie", "w-ayi"] },
    { "id": "s14-bukeqi-mifan", "hanzi": "不客气。你吃米饭吗？", "pinyin": "Bú kèqi. Nǐ chī mǐfàn ma?", "english": "You're welcome. Would you like some rice?", "words": ["w-bukeqi", "w-ni", "w-chi", "w-mifan", "w-ma"] }
  ],
