  "grammar": [
    { "id": "g14-location", "title": "Where things are", "body": "Say where something is with 在 + place + position word: 在桌子上 (on the table), 在杯子里 (in the cup), 在桌子后面 (behind the table).\nThe position word comes after the thing, the opposite of English.", "examples": ["s14-beizizaizhuozishang", "s14-beiziliyoucha", "s14-zaizhuozihoumian"] },
    { "id": "g14-xie", "title": "These and those: 这些, 那些", "body": "Add 些 to 这 or 那 to talk about several things: 这些东西 (these things). No other measure word is needed.", "examples": ["s14-zhexiedongxi"] },
    { "id": "g14-ai", "title": "爱 for things you love doing", "body": "爱 is not only for people. 爱吃 means \"love to eat\", like a stronger 喜欢吃.", "examples": ["s14-aichijiaozi", "s14-woaini"] }
  ],
