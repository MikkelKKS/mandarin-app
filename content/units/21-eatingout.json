  "grammar": [
    { "id": "g21-haishi", "title": "还是 or 或者?", "body": "Both mean \"or\". 还是 asks someone to choose: 啤酒还是果汁? 或者 is for statements: 茶或者咖啡都可以.", "examples": ["s21-pijiuhaishiguozhi", "s21-chahuozhekafei"] },
    { "id": "g21-ji", "title": "好吃极了: extremely", "body": "Adjective + 极了 means \"extremely\": 好吃极了 (incredibly tasty), 渴极了 (so thirsty).", "examples": ["s21-haochijile", "s21-kejile-guozhi"] },
    { "id": "g21-jiao", "title": "Prices with 角", "body": "1 yuan = 10 角. Price tags write 角; Beijingers say 毛. In speech the last unit is often dropped: 三块五 = 3.50.", "examples": ["s21-sankuaiwu", "s21-yijiaoshishifen"] },
    { "id": "g21-zhong", "title": "种: kind", "body": "种 is a measure word for kinds and types: 这种水果 (this kind of fruit), 哪种? (which kind?).", "examples": ["s21-zhezhongshuiguo", "s21-nazhong"] }
  ],
