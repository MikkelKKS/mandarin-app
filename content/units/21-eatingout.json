    { "id": "s21-nazhong", "hanzi": "你喜欢哪种？", "pinyin": "Nǐ xǐhuan nǎ zhǒng?", "english": "Which kind do you like?", "words": ["w-ni", "w-xihuan", "w-na3", "w-zhong"] },
    { "id": "s21-haiyaoqita", "hanzi": "你还要其他的吗？", "pinyin": "Nǐ hái yào qítā de ma?", "english": "Anything else?", "words": ["w-ni", "w-hai-still", "w-yao", "w-qita", "w-de", "w-ma"] },
    { "id": "s21-buyaole-baole", "hanzi": "不要了，谢谢。我吃饱了。", "pinyin": "Bú yào le, xièxie. Wǒ chī bǎo le.", "english": "No more, thanks. I'm full.", "words": ["w-bu", "w-yao", "w-le", "w-xiexie", "w-wo", "w-chi", "w-bao", "w-le"] },
