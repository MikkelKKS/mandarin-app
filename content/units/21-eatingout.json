    { "id": "s21-qinggeicaidan", "hanzi": "服务员，请给我们菜单。", "pinyin": "Fúwùyuán, qǐng gěi wǒmen càidān.", "english": "Excuse me, could we have the menu?", "words": ["w-fuwuyuan", "w-qing", "w-gei", "w-women", "w-caidan"] },
    { "id": "s21-miantiaohaishimifan", "hanzi": "米格，你想吃面条还是米饭？", "pinyin": "Mǐgé, nǐ xiǎng chī miàntiáo háishi mǐfàn?", "english": "米格, would you like noodles or rice?", "words": ["w-mikkel", "w-ni", "w-xiang", "w-chi", "w-miantiao", "w-haishi", "w-mifan"] },
    { "id": "s21-xiangchizhajiangmian", "hanzi": "我想吃北京的炸酱面！", "pinyin": "Wǒ xiǎng chī Běijīng de zhájiàngmiàn!", "english": "I want to try Beijing zhajiang noodles!", "words": ["w-wo", "w-xiang", "w-chi", "w-beijing", "w-de", "w-zhajiangmian"] },
    { "id": "s21-yiwanzhajiangmian", "hanzi": "我要一碗炸酱面。", "pinyin": "Wǒ yào yì wǎn zhájiàngmiàn.", "english": "A bowl of zhajiang noodles, please.", "words": ["w-wo", "w-yao", "w-yi", "w-wan", "w-zhajiangmian"] },
    { "id": "s21-haochijile", "hanzi": "这家的炸酱面好吃极了！", "pinyin": "Zhè jiā de zhájiàngmiàn hǎochī jí le!", "english": "The zhajiang noodles here are amazing!", "words": ["w-zhe", "w-jia", "w-de", "w-zhajiangmian", "w-haochi", "w-ji-extremely", "w-le"] },
    { "id": "s21-zhendidao", "hanzi": "真地道！", "pinyin": "Zhēn dìdao!", "english": "So authentic!", "words": ["w-zhen", "w-didao"] },
    { "id": "s21-chikaoya", "hanzi": "咱们去吃北京烤鸭吧！", "pinyin": "Zánmen qù chī Běijīng kǎoyā ba!", "english": "Let's go and have Peking duck!", "words": ["w-zanmen", "w-qu", "w-chi", "w-beijing", "w-kaoya", "w-ba-particle"] },
    { "id": "s21-pijiuhaishiguozhi", "hanzi": "你喝啤酒还是果汁？", "pinyin": "Nǐ hē píjiǔ háishi guǒzhī?", "english": "Will you have beer or juice?", "words": ["w-ni", "w-he-drink", "w-pijiu", "w-haishi", "w-guozhi"] },
    { "id": "s21-kejile-guozhi", "hanzi": "我渴极了，要一杯果汁。", "pinyin": "Wǒ kě jí le, yào yì bēi guǒzhī.", "english": "I'm really thirsty. A glass of juice, please.", "words": ["w-wo", "w-ke-thirsty", "w-ji-extremely", "w-le", "w-yao", "w-yi", "w-bei", "w-guozhi"] },
    { "id": "s21-wokele", "hanzi": "我渴了。", "pinyin": "Wǒ kě le.", "english": "I'm thirsty.", "words": ["w-wo", "w-ke-thirsty", "w-le"] },
    { "id": "s21-hebeipijiu", "hanzi": "爸，咱们喝杯啤酒吧！", "pinyin": "Bà, zánmen hē bēi píjiǔ ba!", "english": "Dad, let's have a beer!", "words": ["w-ba-dad", "w-zanmen", "w-he-drink", "w-bei", "w-pijiu", "w-ba-particle"] },
    { "id": "s21-chahuozhekafei", "hanzi": "喝茶或者咖啡都可以。", "pinyin": "Hē chá huòzhě kāfēi dōu kěyǐ.", "english": "Tea or coffee, either is fine.", "words": ["w-he-drink", "w-cha", "w-huozhe", "w-kafei", "w-dou", "w-keyi"] },
    { "id": "s21-quchaoshi", "hanzi": "我去超市买点东西。", "pinyin": "Wǒ qù chāoshì mǎi diǎn dōngxi.", "english": "I'm going to the supermarket to get a few things.", "words": ["w-wo", "w-qu", "w-chaoshi", "w-mai3", "w-dian", "w-dongxi"] },
    { "id": "s21-xinxianmianbao", "hanzi": "超市里有新鲜的面包。", "pinyin": "Chāoshì lǐ yǒu xīnxiān de miànbāo.", "english": "The supermarket has fresh bread.", "words": ["w-chaoshi", "w-li-inside", "w-you", "w-xinxian", "w-de", "w-mianbao"] },
    { "id": "s21-putaoxinxian", "hanzi": "这些葡萄很新鲜。", "pinyin": "Zhèxiē pútao hěn xīnxiān.", "english": "These grapes are very fresh.", "words": ["w-zhe", "w-xie", "w-putao", "w-hen", "w-xinxian"] },
    { "id": "s21-xiangjiaoduoshao", "hanzi": "香蕉多少钱一斤？", "pinyin": "Xiāngjiāo duōshao qián yì jīn?", "english": "How much are bananas per jin?", "words": ["w-xiangjiao", "w-duoshao", "w-qian", "w-yi", "w-jin-weight"] },
    { "id": "s21-sankuaiwu", "hanzi": "三块五一斤。", "pinyin": "Sān kuài wǔ yì jīn.", "english": "3.50 a jin.", "words": ["w-san", "w-kuai", "w-wu", "w-yi", "w-jin-weight"] },
    { "id": "s21-yijiaoshishifen", "hanzi": "一角是十分钱。", "pinyin": "Yì jiǎo shì shí fēn qián.", "english": "One jiao is ten fen.", "words": ["w-yi", "w-jiao-money", "w-shi", "w-shi2", "w-fen", "w-qian"] },
    { "id": "s21-baozainar", "hanzi": "我的包在哪儿？", "pinyin": "Wǒ de bāo zài nǎr?", "english": "Where's my bag?", "words": ["w-wo", "w-de", "w-bao-bag", "w-zai", "w-nar"] },
