    { "id": "s16-xiguaduoshao", "hanzi": "西瓜多少钱一斤？", "pinyin": "Xīguā duōshao qián yì jīn?", "english": "How much is the watermelon per jin?", "words": ["w-xigua", "w-duoshao", "w-qian", "w-yi", "w-jin-weight"] },
    { "id": "s16-sankuaiyijin", "hanzi": "三块一斤。", "pinyin": "Sān kuài yì jīn.", "english": "Three kuai a jin.", "words": ["w-san", "w-kuai", "w-yi", "w-jin-weight"] },
    { "id": "s16-yangrouduoshao", "hanzi": "羊肉多少钱一斤？", "pinyin": "Yángròu duōshao qián yì jīn?", "english": "How much is the lamb per jin?", "words": ["w-yangrou", "w-duoshao", "w-qian", "w-yi", "w-jin-weight"] },
    { "id": "s16-sishikuai", "hanzi": "四十块一斤。", "pinyin": "Sìshí kuài yì jīn.", "english": "Forty kuai a jin.", "words": ["w-si", "w-shi2", "w-kuai", "w-yi", "w-jin-weight"] },
    { "id": "s16-gongjinshiliangjin", "hanzi": "一公斤是两斤。", "pinyin": "Yì gōngjīn shì liǎng jīn.", "english": "A kilo is two jin.", "words": ["w-yi", "w-gongjin", "w-shi", "w-liang", "w-jin-weight"] },
    { "id": "s16-maiyigexigua", "hanzi": "我要买一个西瓜。", "pinyin": "Wǒ yào mǎi yí ge xīguā.", "english": "I'd like to buy a watermelon.", "words": ["w-wo", "w-yao", "w-mai3", "w-yi", "w-ge", "w-xigua"] },
    { "id": "s16-shigejidan", "hanzi": "我买了十个鸡蛋。", "pinyin": "Wǒ mǎi le shí ge jīdàn.", "english": "I bought ten eggs.", "words": ["w-wo", "w-mai3", "w-le", "w-shi2", "w-ge", "w-jidan"] },
    { "id": "s16-heniunaima", "hanzi": "你喝牛奶吗？", "pinyin": "Nǐ hē niúnǎi ma?", "english": "Do you drink milk?", "words": ["w-ni", "w-he-drink", "w-niunai", "w-ma"] },
    { "id": "s16-xihuanyangrou", "hanzi": "我很喜欢吃羊肉。", "pinyin": "Wǒ hěn xǐhuan chī yángròu.", "english": "I really like lamb.", "words": ["w-wo", "w-hen", "w-xihuan", "w-chi", "w-yangrou"] },
    { "id": "s16-taihaole-yangrou", "hanzi": "太好了！我很喜欢吃羊肉。", "pinyin": "Tài hǎo le! Wǒ hěn xǐhuan chī yángròu.", "english": "Great! I really like lamb.", "words": ["w-tai", "w-hao", "w-le", "w-wo", "w-hen", "w-xihuan", "w-chi", "w-yangrou"] },
    { "id": "s16-zanmenchishuanyangrou", "hanzi": "米格，今天晚上咱们吃涮羊肉吧！", "pinyin": "Mǐgé, jīntiān wǎnshang zánmen chī shuànyángròu ba!", "english": "米格, let's have lamb hot pot tonight!", "words": ["w-mikkel", "w-jintian", "w-wanshang", "w-zanmen", "w-chi", "w-shuanyangrou", "w-ba-particle"] },
    { "id": "s16-maiyangrou-jidan", "hanzi": "咱们去买两公斤羊肉，再买点鸡蛋和牛奶。", "pinyin": "Zánmen qù mǎi liǎng gōngjīn yángròu, zài mǎi diǎn jīdàn hé niúnǎi.", "english": "Let's buy two kilos of lamb, and some eggs and milk too.", "words": ["w-zanmen", "w-qu", "w-mai3", "w-liang", "w-gongjin", "w-yangrou", "w-zai-again", "w-mai3", "w-dian", "w-jidan", "w-he", "w-niunai"] },
    { "id": "s16-yigongduoshao", "hanzi": "一共多少钱？", "pinyin": "Yígòng duōshao qián?", "english": "How much is it altogether?", "words": ["w-yigong", "w-duoshao", "w-qian"] },
    { "id": "s16-yibaibashiyuan", "hanzi": "一共一百八十元。", "pinyin": "Yígòng yìbǎi bāshí yuán.", "english": "180 yuan altogether.", "words": ["w-yigong", "w-yi", "w-bai3", "w-ba", "w-shi2", "w-yuan-money"] },
    { "id": "s16-wolaiba", "hanzi": "我来吧！", "pinyin": "Wǒ lái ba!", "english": "Let me (pay)!", "words": ["w-wo", "w-lai", "w-ba-particle"], "alt": { "english": ["Let me do it!", "I'll get it!"] } },
    { "id": "s16-shoubiaoyiqian", "hanzi": "这块手表一千块。", "pinyin": "Zhè kuài shǒubiǎo yìqiān kuài.", "english": "This watch costs a thousand kuai.", "words": ["w-zhe", "w-kuai", "w-shoubiao", "w-yi", "w-qian-thousand", "w-kuai"] },
    { "id": "s16-wodeshoubiao", "hanzi": "我的手表是新的。", "pinyin": "Wǒ de shǒubiǎo shì xīn de.", "english": "My watch is new.", "words": ["w-wo", "w-de", "w-shoubiao", "w-shi", "w-xin", "w-de"] },
    { "id": "s16-zhangzhaopian", "hanzi": "这张照片真漂亮。", "pinyin": "Zhè zhāng zhàopiàn zhēn piàoliang.", "english": "This photo is really beautiful.", "words": ["w-zhe", "w-zhang", "w-zhaopian", "w-zhen", "w-piaoliang"] },
    { "id": "s16-yizhangdazhuozi", "hanzi": "家里有一张大桌子。", "pinyin": "Jiā lǐ yǒu yì zhāng dà zhuōzi.", "english": "There's a big table at home.", "words": ["w-jia", "w-li-inside", "w-you", "w-yi", "w-zhang", "w-da", "w-zhuozi"] },
    { "id": "s16-xihuanshenmeyanse", "hanzi": "你喜欢什么颜色？", "pinyin": "Nǐ xǐhuan shénme yánsè?", "english": "What colour do you like?", "words": ["w-ni", "w-xihuan", "w-shenme", "w-yanse"] },
    { "id": "s16-woyaohongde", "hanzi": "我要红的。", "pinyin": "Wǒ yào hóng de.", "english": "I'd like the red one.", "words": ["w-wo", "w-yao", "w-hong", "w-de"] },
    { "id": "s16-youbaidema", "hanzi": "有白的吗？", "pinyin": "Yǒu bái de ma?", "english": "Do you have a white one?", "words": ["w-you", "w-bai-white", "w-de", "w-ma"] },
