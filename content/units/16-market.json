    { "id": "s16-chuanhongyifu", "hanzi": "她今天穿了一件红衣服。", "pinyin": "Tā jīntiān chuān le yí jiàn hóng yīfu.", "english": "She's wearing a red top today.", "words": ["w-ta-she", "w-jintian", "w-chuan", "w-le", "w-yi", "w-jian-item", "w-hong", "w-yifu"] },
