    { "id": "s16-yifutaichang", "hanzi": "这件衣服太长了。", "pinyin": "Zhè jiàn yīfu tài cháng le.", "english": "This is too long.", "words": ["w-zhe", "w-jian-item", "w-yifu", "w-tai", "w-chang-long", "w-le"] },
    { "id": "s16-qingtian", "hanzi": "今天是晴天。", "pinyin": "Jīntiān shì qíngtiān.", "english": "It's sunny today.", "words": ["w-jintian", "w-shi", "w-qing-sunny", "w-tian"] },
    { "id": "s16-yintian", "hanzi": "今天阴天，可能会下雪。", "pinyin": "Jīntiān yīntiān, kěnéng huì xià xuě.", "english": "It's cloudy today. It might snow.", "words": ["w-jintian", "w-yin", "w-tian", "w-keneng", "w-hui", "w-xia", "w-xue-snow"] },
