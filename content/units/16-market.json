  "grammar": [
    { "id": "g16-yuan", "title": "元 and 块, and big numbers", "body": "元 is written on price tags; people say 块. Both mean yuan.\nBig numbers build like this: 一百 (100), 一百八十 (180), 一千 (1000). Prices per weight put the unit last: 三块一斤 (3 kuai a jin). One jin is half a kilo.", "examples": ["s16-yibaibashiyuan", "s16-sankuaiyijin", "s16-gongjinshiliangjin"] },
    { "id": "g16-de-one", "title": "红的: the red one", "body": "Adjective + 的 stands for \"the ... one\": 红的 (the red one), 新的 (a new one), 黑的 (the black one).", "examples": ["s16-woyaohongde", "s16-youbaidema", "s16-wodeshoubiao"] },
    { "id": "g16-zhang", "title": "张 for flat things", "body": "Use 张 for things with a flat surface: photos, tables, tickets, paper. 一张照片, 一张桌子.", "examples": ["s16-zhangzhaopian", "s16-yizhangdazhuozi"] },
    { "id": "g16-weather", "title": "Talking about the weather", "body": "晴天 (sunny day), 阴天 (cloudy day). Snow and rain \"come down\": 下雪, 下雨. Add 了 when it has started: 下雪了!", "examples": ["s16-qingtian", "s16-yintian", "s16-duochuandian"] }
  ],
