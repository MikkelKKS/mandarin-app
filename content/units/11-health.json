  "sentences": [
    { "id": "s-nizenmele", "hanzi": "你怎么了？", "pinyin": "Nǐ zěnme le?", "english": "What's wrong?", "words": ["w-ni", "w-zenme", "w-le"], "alt": { "english": ["What's the matter?"] } },
    { "id": "s-mikkel-zenmele", "hanzi": "米格，你怎么了？", "pinyin": "Mǐgé, nǐ zěnme le?", "english": "米格, what's wrong?", "words": ["w-mikkel", "w-ni", "w-zenme", "w-le"] },
    { "id": "s-nanalibushufu", "hanzi": "你哪里不舒服？", "pinyin": "Nǐ nǎlǐ bù shūfu?", "english": "Where don't you feel well?", "words": ["w-ni", "w-nali", "w-bu", "w-shufu"], "alt": { "english": ["What's bothering you?"] } },
    { "id": "s-wotouteng", "hanzi": "我头疼。", "pinyin": "Wǒ tóu téng.", "english": "I've got a headache.", "words": ["w-wo", "w-tou", "w-teng"] },
    { "id": "s-duziyoudianteng", "hanzi": "我肚子有点疼。", "pinyin": "Wǒ dùzi yǒudiǎn téng.", "english": "My stomach hurts a bit.", "words": ["w-wo", "w-duzi", "w-you", "w-dian", "w-teng"] },
    { "id": "s-yanjingbushufu", "hanzi": "我眼睛不舒服。", "pinyin": "Wǒ yǎnjing bù shūfu.", "english": "My eyes are bothering me.", "words": ["w-wo", "w-yanjing", "w-bu", "w-shufu"] },
    { "id": "s-woganmaole", "hanzi": "我感冒了。", "pinyin": "Wǒ gǎnmào le.", "english": "I've caught a cold.", "words": ["w-wo", "w-ganmao", "w-le"] },
    { "id": "s-ganmao-touteng", "hanzi": "我感冒了，头有点疼。", "pinyin": "Wǒ gǎnmào le, tóu yǒudiǎn téng.", "english": "I've got a cold and a bit of a headache.", "words": ["w-wo", "w-ganmao", "w-le", "w-tou", "w-you", "w-dian", "w-teng"] },
    { "id": "s-woshengbingle", "hanzi": "我生病了。", "pinyin": "Wǒ shēngbìng le.", "english": "I'm ill.", "words": ["w-wo", "w-shengbing", "w-le"] },
    { "id": "s-nifashaolema", "hanzi": "你发烧了吗？", "pinyin": "Nǐ fāshāo le ma?", "english": "Do you have a fever?", "words": ["w-ni", "w-fashao", "w-le", "w-ma"] },
    { "id": "s-youyidianfashao", "hanzi": "有一点发烧。", "pinyin": "Yǒu yìdiǎn fāshāo.", "english": "A bit of a fever.", "words": ["w-you", "w-yidian", "w-fashao"] },
    { "id": "s-yinggaikanyisheng", "hanzi": "你应该去看医生。", "pinyin": "Nǐ yīnggāi qù kàn yīshēng.", "english": "You should see a doctor.", "words": ["w-ni", "w-yinggai", "w-qu", "w-kan", "w-yisheng"] },
    { "id": "s-chidianyaoba", "hanzi": "吃点药吧。", "pinyin": "Chī diǎn yào ba.", "english": "Take some medicine.", "words": ["w-chi", "w-dian", "w-yao-medicine", "w-ba-particle"] },
    { "id": "s-duoheshui", "hanzi": "多喝水，多休息。", "pinyin": "Duō hē shuǐ, duō xiūxi.", "english": "Drink lots of water and get plenty of rest.", "words": ["w-duo", "w-he-drink", "w-shui", "w-duo", "w-xiuxi"] },
    { "id": "s-kanyisheng-duoheshui", "hanzi": "你应该去看医生。多喝水，多休息！", "pinyin": "Nǐ yīnggāi qù kàn yīshēng. Duō hē shuǐ, duō xiūxi!", "english": "You should see a doctor. Drink lots of water and rest!", "words": ["w-ni", "w-yinggai", "w-qu", "w-kan", "w-yisheng", "w-duo", "w-he-drink", "w-shui", "w-duo", "w-xiuxi"] },
    { "id": "s-haohaoxiuxi", "hanzi": "你今天好好休息吧。", "pinyin": "Nǐ jīntiān hǎohǎo xiūxi ba.", "english": "Get some proper rest today.", "words": ["w-ni", "w-jintian", "w-hao", "w-hao", "w-xiuxi", "w-ba-particle"] },
    { "id": "s-biedanxin", "hanzi": "别担心，我没事。", "pinyin": "Bié dānxīn, wǒ méi shì.", "english": "Don't worry, I'm fine.", "words": ["w-bie", "w-danxin", "w-wo", "w-mei", "w-shi-matter"] },
    { "id": "s-fangxinba", "hanzi": "放心吧！", "pinyin": "Fàngxīn ba!", "english": "Don't worry!", "words": ["w-fangxin", "w-ba-particle"], "alt": { "english": ["Rest assured!"] } },
    { "id": "s-xiaoxin", "hanzi": "小心！", "pinyin": "Xiǎoxīn!", "english": "Careful!", "words": ["w-xiaoxin"] },
    { "id": "s-nishentizenmeyang", "hanzi": "您身体怎么样？", "pinyin": "Nín shēntǐ zěnmeyàng?", "english": "How is your health? (polite)", "words": ["w-nin", "w-shenti", "w-zenmeyang"] },
    { "id": "s-shentihenhao", "hanzi": "我身体很好，谢谢。", "pinyin": "Wǒ shēntǐ hěn hǎo, xièxie.", "english": "I'm in good health, thank you.", "words": ["w-wo", "w-shenti", "w-hen", "w-hao", "w-xiexie"] },
    { "id": "s-xiwangshentijiankang", "hanzi": "希望您身体健康！", "pinyin": "Xīwàng nín shēntǐ jiànkāng!", "english": "Wishing you good health!", "words": ["w-xiwang", "w-nin", "w-shenti", "w-jiankang"] },
    { "id": "s-hao-xiexieayi", "hanzi": "好，谢谢阿姨。", "pinyin": "Hǎo, xièxie āyí.", "english": "OK, thank you.", "words": ["w-hao", "w-xiexie", "w-ayi"] }
