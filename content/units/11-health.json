  "grammar": [
    { "id": "g-teng", "title": "What hurts: body part + 疼", "body": "头疼 = headache, 肚子疼 = stomach ache. Soften with 有点: 我肚子有点疼. 有点 + adjective is for things you don't like (有点辣, 有点累).", "examples": ["s-wotouteng", "s-duziyoudianteng"] },
    { "id": "g-yinggai", "title": "应该 = should", "body": "应该 + verb gives advice: 你应该去看医生.", "examples": ["s-yinggaikanyisheng"] },
    { "id": "g-duobie", "title": "多… and 别…", "body": "多 + verb = do more of it: 多喝水，多休息. 别 + verb = don't: 别担心 (don't worry).", "examples": ["s-duoheshui", "s-biedanxin"] },
    { "id": "g-shenti", "title": "Health wishes for elders", "body": "Ask older relatives 您身体怎么样？ and wish them 身体健康 (good health), e.g. 希望您身体健康！ It's a classic toast at family dinners.", "examples": ["s-nishentizenmeyang", "s-xiwangshentijiankang"] }
  ],
