  "grammar": [
    { "id": "g15-neng", "title": "能 or 会?", "body": "会 is a skill you have learned: 我会写我的中文名字. 能 is being able to right now, or being allowed: 我今天不能去.\n你能…吗？ is a polite way to ask for something.", "examples": ["s15-nengshuomanyidian", "s15-jintianbunengqu", "s15-xiemingzi"] },
    { "id": "g15-dates", "title": "Dates go big to small", "body": "Year, then month, then day: 二零二六年三月十日. Read years digit by digit, with 零 for 0.\n日 is written; in speech people usually say 号: 三月十号.", "examples": ["s15-ererlingliu", "s15-shengrishiri"] },
    { "id": "g15-wei", "title": "喂 on the phone", "body": "Answer the phone with 喂 (written wèi, usually said rising: wéi), like \"hello?\". Don't use it face to face: it sounds like \"hey, you!\".", "examples": ["s15-wei-ninhao", "s15-wei-shimige"] }
  ],
