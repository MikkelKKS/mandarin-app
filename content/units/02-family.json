  "sentences": [
    { "id": "s-shushuhao", "hanzi": "叔叔好！", "pinyin": "Shūshu hǎo!", "english": "Hello! (to her father)", "words": ["w-shushu", "w-hao"], "alt": { "english": ["Hello, uncle!"] } },
    { "id": "s-ayihao", "hanzi": "阿姨好！", "pinyin": "Āyí hǎo!", "english": "Hello! (to her mother)", "words": ["w-ayi", "w-hao"], "alt": { "english": ["Hello, auntie!"] } },
    { "id": "s-shushuhao-ayihao", "hanzi": "叔叔好！阿姨好！", "pinyin": "Shūshu hǎo! Āyí hǎo!", "english": "Hello! (to her father and mother)", "words": ["w-shushu", "w-hao", "w-ayi", "w-hao"] },
    { "id": "s-nijiayoujikouren", "hanzi": "你家有几口人？", "pinyin": "Nǐ jiā yǒu jǐ kǒu rén?", "english": "How many people are in your family?", "words": ["w-ni", "w-jia", "w-you", "w-ji", "w-kou", "w-ren"] },
    { "id": "s-mikkel-jikouren", "hanzi": "米格，你家有几口人？", "pinyin": "Mǐgé, nǐ jiā yǒu jǐ kǒu rén?", "english": "Mikkel, how many people are in your family?", "words": ["w-mikkel", "w-ni", "w-jia", "w-you", "w-ji", "w-kou", "w-ren"] },
    { "id": "s-wojiayousikouren", "hanzi": "我家有四口人。", "pinyin": "Wǒ jiā yǒu sì kǒu rén.", "english": "There are four people in my family.", "words": ["w-wo", "w-jia", "w-you", "w-si", "w-kou", "w-ren"] },
    { "id": "s-babamamagegehewo", "hanzi": "爸爸、妈妈、哥哥和我。", "pinyin": "Bàba, māma, gēge hé wǒ.", "english": "Dad, Mum, my older brother and me.", "words": ["w-baba", "w-mama", "w-gege", "w-he", "w-wo"] },
    { "id": "s-niyougegema", "hanzi": "你有哥哥吗？", "pinyin": "Nǐ yǒu gēge ma?", "english": "Do you have an older brother?", "words": ["w-ni", "w-you", "w-gege", "w-ma"] },
    { "id": "s-woyouyigejiejie", "hanzi": "我有一个姐姐。", "pinyin": "Wǒ yǒu yí ge jiějie.", "english": "I have an older sister.", "words": ["w-wo", "w-you", "w-yi", "w-ge", "w-jiejie"] },
    { "id": "s-meiyougege-youjiejie", "hanzi": "我没有哥哥，有一个姐姐。", "pinyin": "Wǒ méiyǒu gēge, yǒu yí ge jiějie.", "english": "I don't have an older brother, but I have an older sister.", "words": ["w-wo", "w-mei", "w-you", "w-gege", "w-you", "w-yi", "w-ge", "w-jiejie"] },
    { "id": "s-womeiyoudidi", "hanzi": "我没有弟弟。", "pinyin": "Wǒ méiyǒu dìdi.", "english": "I don't have a younger brother.", "words": ["w-wo", "w-mei", "w-you", "w-didi"] },
    { "id": "s-tayouliangge-meimei", "hanzi": "她有两个妹妹。", "pinyin": "Tā yǒu liǎng ge mèimei.", "english": "She has two younger sisters.", "words": ["w-ta-she", "w-you", "w-liang", "w-ge", "w-meimei"] },
    { "id": "s-zheshishei", "hanzi": "这是谁？", "pinyin": "Zhè shì shéi?", "english": "Who's this?", "words": ["w-zhe", "w-shi", "w-shei"] },
    { "id": "s-zheshiwobaba", "hanzi": "这是我爸爸。", "pinyin": "Zhè shì wǒ bàba.", "english": "This is my dad.", "words": ["w-zhe", "w-shi", "w-wo", "w-baba"] },
    { "id": "s-nashiwomama", "hanzi": "那是我妈妈。", "pinyin": "Nà shì wǒ māma.", "english": "That's my mum.", "words": ["w-na4", "w-shi", "w-wo", "w-mama"] },
    { "id": "s-baba-nashimama", "hanzi": "这是我爸爸，那是我妈妈。", "pinyin": "Zhè shì wǒ bàba, nà shì wǒ māma.", "english": "This is my dad, and that's my mum.", "words": ["w-zhe", "w-shi", "w-wo", "w-baba", "w-na4", "w-shi", "w-wo", "w-mama"] },
    { "id": "s-tashiwonvpengyou", "hanzi": "她是我女朋友。", "pinyin": "Tā shì wǒ nǚpéngyou.", "english": "She's my girlfriend.", "words": ["w-ta-she", "w-shi", "w-wo", "w-nvpengyou"] },
    { "id": "s-tashiwopengyou", "hanzi": "他是我朋友。", "pinyin": "Tā shì wǒ péngyou.", "english": "He's my friend.", "words": ["w-ta-he", "w-shi", "w-wo", "w-pengyou"] },
    { "id": "s-nikan-zhaopian", "hanzi": "你看，这是我们家的照片。", "pinyin": "Nǐ kàn, zhè shì wǒmen jiā de zhàopiàn.", "english": "Look, this is a photo of our family.", "words": ["w-ni", "w-kan", "w-zhe", "w-shi", "w-women", "w-jia", "w-de", "w-zhaopian"] },
    { "id": "s-nikan", "hanzi": "你看！", "pinyin": "Nǐ kàn!", "english": "Look!", "words": ["w-ni", "w-kan"] },
    { "id": "s-niduodale", "hanzi": "你多大了？", "pinyin": "Nǐ duō dà le?", "english": "How old are you?", "words": ["w-ni", "w-duo", "w-da", "w-le"] },
    { "id": "s-wogegesanshisuile", "hanzi": "我哥哥三十岁了。", "pinyin": "Wǒ gēge sānshí suì le.", "english": "My older brother is thirty.", "words": ["w-wo", "w-gege", "w-san", "w-shi2", "w-sui", "w-le"] },
    { "id": "s-babamamadouhenhao", "hanzi": "我爸爸妈妈都很好。", "pinyin": "Wǒ bàba māma dōu hěn hǎo.", "english": "My mum and dad are both well.", "words": ["w-wo", "w-baba", "w-mama", "w-dou", "w-hen", "w-hao"] },
    { "id": "s-babamamadouhuishuo", "hanzi": "你爸爸妈妈都会说中文吗？", "pinyin": "Nǐ bàba māma dōu huì shuō Zhōngwén ma?", "english": "Do your mum and dad both speak Chinese?", "words": ["w-ni", "w-baba", "w-mama", "w-dou", "w-hui", "w-shuo", "w-zhongwen", "w-ma"] },
    { "id": "s-buhui", "hanzi": "不会。", "pinyin": "Bú huì.", "english": "No, they can't.", "words": ["w-bu", "w-hui"], "alt": { "english": ["No."] } },
    { "id": "s-wojiayouyizhigou", "hanzi": "我家有一只狗。", "pinyin": "Wǒ jiā yǒu yì zhī gǒu.", "english": "We have a dog at home.", "words": ["w-wo", "w-jia", "w-you", "w-yi", "w-zhi", "w-gou"], "alt": { "english": ["My family has a dog."] } }
  ],
