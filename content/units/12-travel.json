    { "id": "s-bazhaopiangeiwokan", "hanzi": "请把照片给我看看。", "pinyin": "Qǐng bǎ zhàopiàn gěi wǒ kànkan.", "english": "Show me the photos, please.", "words": ["w-qing", "w-ba-object", "w-zhaopian", "w-gei", "w-wo", "w-kan", "w-kan"] },
    { "id": "s-qianbaodiule", "hanzi": "我的钱包丢了！", "pinyin": "Wǒ de qiánbāo diū le!", "english": "I've lost my wallet!", "words": ["w-wo", "w-de", "w-qianbao", "w-diu", "w-le"] },
    { "id": "s-shoujibeimeimeinazoule", "hanzi": "我的手机被我妹妹拿走了。", "pinyin": "Wǒ de shǒujī bèi wǒ mèimei ná zǒu le.", "english": "My phone was taken by my little sister.", "words": ["w-wo", "w-de", "w-shouji", "w-bei-passive", "w-wo", "w-meimei", "w-na-take", "w-zou", "w-le"] },
    { "id": "s-xinglibeifangzaibinguan", "hanzi": "行李被我放在宾馆了。", "pinyin": "Xíngli bèi wǒ fàng zài bīnguǎn le.", "english": "I left the luggage at the hotel.", "words": ["w-xingli", "w-bei-passive", "w-wo", "w-fang-put", "w-zai", "w-binguan", "w-le"] },
    { "id": "s-zhaobudaohuzhao", "hanzi": "我找不到我的护照。", "pinyin": "Wǒ zhǎo bu dào wǒ de hùzhào.", "english": "I can't find my passport.", "words": ["w-wo", "w-zhao", "w-bu", "w-dao", "w-wo", "w-de", "w-huzhao"] },
    { "id": "s-a-zhaobudao", "hanzi": "啊，我找不到我的护照！", "pinyin": "À, wǒ zhǎo bu dào wǒ de hùzhào!", "english": "Oh no, I can't find my passport!", "words": ["w-a", "w-wo", "w-zhao", "w-bu", "w-dao", "w-wo", "w-de", "w-huzhao"] },
    { "id": "s-biedanxin-bangnizhao", "hanzi": "别担心，我帮你找吧！", "pinyin": "Bié dānxīn, wǒ bāng nǐ zhǎo ba!", "english": "Don't worry, I'll help you look!", "words": ["w-bie", "w-danxin", "w-wo", "w-bang", "w-ni", "w-zhao", "w-ba-particle"] },
