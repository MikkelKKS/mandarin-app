    { "id": "s-mikkel-qunaliwan", "hanzi": "米格，你想去哪里玩？", "pinyin": "Mǐgé, nǐ xiǎng qù nǎlǐ wán?", "english": "米格, where would you like to go?", "words": ["w-mikkel", "w-ni", "w-xiang", "w-qu", "w-nali", "w-wan-play"] },
    { "id": "s-changcheng-youming", "hanzi": "我想去长城。长城很有名！", "pinyin": "Wǒ xiǎng qù Chángchéng. Chángchéng hěn yǒumíng!", "english": "I'd like to see the Great Wall. It's so famous!", "words": ["w-wo", "w-xiang", "w-qu", "w-changcheng", "w-changcheng", "w-hen", "w-youming"] },
    { "id": "s-xianqu-ranhou", "hanzi": "好啊！我们先去长城，然后去吃饭。", "pinyin": "Hǎo a! Wǒmen xiān qù Chángchéng, ránhòu qù chīfàn.", "english": "Sure! First the Great Wall, then we'll go and eat.", "words": ["w-hao", "w-a", "w-women", "w-xian", "w-qu", "w-changcheng", "w-ranhou", "w-qu", "w-chi", "w-fan"] },
    { "id": "s-xianbinguan", "hanzi": "我们先去宾馆，然后去吃饭。", "pinyin": "Wǒmen xiān qù bīnguǎn, ránhòu qù chīfàn.", "english": "First we'll go to the hotel, then go and eat.", "words": ["w-women", "w-xian", "w-qu", "w-binguan", "w-ranhou", "w-qu", "w-chi", "w-fan"] },
    { "id": "s-nidingfangjianlema", "hanzi": "你订房间了吗？", "pinyin": "Nǐ dìng fángjiān le ma?", "english": "Have you booked a room?", "words": ["w-ni", "w-ding", "w-fangjian", "w-le", "w-ma"] },
    { "id": "s-yijingdinghaole", "hanzi": "我已经订好了。", "pinyin": "Wǒ yǐjīng dìng hǎo le.", "english": "I've already booked it.", "words": ["w-wo", "w-yijing", "w-ding", "w-hao", "w-le"] },
    { "id": "s-biewangjidaihuzhao", "hanzi": "别忘记带护照！", "pinyin": "Bié wàngjì dài hùzhào!", "english": "Don't forget your passport!", "words": ["w-bie", "w-wangji", "w-dai", "w-huzhao"] },
