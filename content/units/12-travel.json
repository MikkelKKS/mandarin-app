    { "id": "s-zhaodaole-zaizheli", "hanzi": "找到了！在这里。", "pinyin": "Zhǎodào le! Zài zhèlǐ.", "english": "Found it! It's here.", "words": ["w-zhao", "w-dao", "w-le", "w-zai", "w-zheli"] },
    { "id": "s-gangcaihaizaizheli", "hanzi": "刚才还在这里！", "pinyin": "Gāngcái hái zài zhèlǐ!", "english": "It was right here a moment ago!", "words": ["w-gangcai", "w-hai-still", "w-zai", "w-zheli"] },
    { "id": "s-xiexie-nizhenhao", "hanzi": "谢谢！你真好！", "pinyin": "Xièxie! Nǐ zhēn hǎo!", "english": "Thanks! You're so kind!", "words": ["w-xiexie", "w-ni", "w-zhen", "w-hao"] },
    { "id": "s-yaobangmangma", "hanzi": "要帮忙吗？", "pinyin": "Yào bāngmáng ma?", "english": "Do you need a hand?", "words": ["w-yao", "w-bangmang", "w-ma"] },
