  "grammar": [
    { "id": "g-ba", "title": "把: doing something to an object", "body": "把 + object + verb + more: 请把照片给我看看 (show me the photos), 我把护照给你 (I'll give you the passport). Use it when you do something definite to a specific thing. The verb can't stand alone; it needs something after it (给你, 看看, 放在…).", "examples": ["s-bazhaopiangeiwokan", "s-bahuzhaogeini"] },
    { "id": "g-bei", "title": "被: the passive", "body": "Thing + 被 + (who) + verb + result: 我的手机被我妹妹拿走了 (my phone was taken by my sister). Often used for things that went wrong.", "examples": ["s-shoujibeimeimeinazoule", "s-xinglibeifangzaibinguan"] },
    { "id": "g-result", "title": "找到了 / 找不到", "body": "Verb + result: 找到 = look for + reach = find. Put 不 in the middle for 'can't': 找不到 = can't find. 找到了！ = found it!", "examples": ["s-zhaobudaohuzhao", "s-zhaodaole-zaizheli"] },
    { "id": "g-yuelaiyue", "title": "越来越 = more and more", "body": "越来越 + adjective + 了: 天气越来越热了 (it's getting hotter), 你的中文越来越好了.", "examples": ["s-tianqiyuelaiyuere", "s-zhongwenyuelaiyuehao"] },
    { "id": "g-yibian", "title": "一边…一边… and 先…然后…", "body": "一边A一边B = doing A and B at the same time: 一边走一边拍照. 先A，然后B = first A, then B.", "examples": ["s-yibianzouyibianpaizhao", "s-xianbinguan"] }
  ],
