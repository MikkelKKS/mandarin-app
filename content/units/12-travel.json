  "sentences": [
    { "id": "s-xiangquchangcheng", "hanzi": "我想去长城。", "pinyin": "Wǒ xiǎng qù Chángchéng.", "english": "I'd like to go to the Great Wall.", "words": ["w-wo", "w-xiang", "w-qu", "w-changcheng"] },
