  "sentences": [
    { "id": "s25-henzhaoji", "hanzi": "我很着急：叔叔是不是不喜欢我？", "pinyin": "Wǒ hěn zháojí: shūshu shì bu shì bù xǐhuan wǒ?", "english": "I'm worried. Does your dad not like me?", "words": ["w-wo", "w-hen", "w-zhaoji", "w-shushu", "w-shi", "w-bu", "w-shi", "w-bu", "w-xihuan", "w-wo"] },
    { "id": "s25-weishenme-biezhaoji", "hanzi": "为什么？你别着急。", "pinyin": "Wèishénme? Nǐ bié zháojí.", "english": "Why? Don't worry.", "words": ["w-weishenme", "w-ni", "w-bie", "w-zhaoji"] },
    { "id": "s25-biezhaoji-manman", "hanzi": "别着急，慢慢来。", "pinyin": "Bié zháojí, mànmàn lái.", "english": "No rush, take your time.", "words": ["w-bie", "w-zhaoji", "w-man", "w-man", "w-lai"] },
    { "id": "s25-turanbushuohua", "hanzi": "他今天突然不说话了。", "pinyin": "Tā jīntiān tūrán bù shuōhuà le.", "english": "He suddenly went quiet today.", "words": ["w-ta-he", "w-jintian", "w-turan", "w-bu", "w-shuohua", "w-le"] },
    { "id": "s25-qishi-yiwei", "hanzi": "其实他很喜欢你！他以为你听不懂他说话。", "pinyin": "Qíshí tā hěn xǐhuan nǐ! Tā yǐwéi nǐ tīng bu dǒng tā shuōhuà.", "english": "Actually he really likes you! He thought you couldn't understand him.", "words": ["w-qishi", "w-ta-he", "w-hen", "w-xihuan", "w-ni", "w-ta-he", "w-yiwei", "w-ni", "w-ting", "w-bu", "w-dong", "w-ta-he", "w-shuohua"] },
    { "id": "s25-woyiweinibulai", "hanzi": "我以为你不来了！", "pinyin": "Wǒ yǐwéi nǐ bù lái le!", "english": "I thought you weren't coming!", "words": ["w-wo", "w-yiwei", "w-ni", "w-bu", "w-lai", "w-le"] },
    { "id": "s25-zhendema", "hanzi": "真的吗？", "pinyin": "Zhēn de ma?", "english": "Really?", "words": ["w-zhen", "w-de", "w-ma"] },
    { "id": "s25-dangran-manyi", "hanzi": "当然！我爸爸对你很满意。", "pinyin": "Dāngrán! Wǒ bàba duì nǐ hěn mǎnyì.", "english": "Of course! My dad is very happy with you.", "words": ["w-dangran", "w-wo", "w-baba", "w-dui", "w-ni", "w-hen", "w-manyi"] },
    { "id": "s25-zhongyufangxin", "hanzi": "太好了！我终于放心了。", "pinyin": "Tài hǎo le! Wǒ zhōngyú fàngxīn le.", "english": "Great! I can finally relax.", "words": ["w-tai", "w-hao", "w-le", "w-wo", "w-zhongyu", "w-fangxin", "w-le"] },
    { "id": "s25-zhongyudaole", "hanzi": "我们终于到了！", "pinyin": "Wǒmen zhōngyú dào le!", "english": "We're finally here!", "words": ["w-women", "w-zhongyu", "w-dao", "w-le"] },
    { "id": "s25-bieshengqile", "hanzi": "别生气了。", "pinyin": "Bié shēngqì le.", "english": "Don't be angry.", "words": ["w-bie", "w-shengqi", "w-le"] },
    { "id": "s25-mamashengqile", "hanzi": "妈妈生气了。", "pinyin": "Māma shēngqì le.", "english": "Mum is angry.", "words": ["w-mama", "w-shengqi", "w-le"] },
    { "id": "s25-haipagou", "hanzi": "我害怕狗。", "pinyin": "Wǒ hàipà gǒu.", "english": "I'm afraid of dogs.", "words": ["w-wo", "w-haipa", "w-gou"] },
    { "id": "s25-henanguo", "hanzi": "她很难过。", "pinyin": "Tā hěn nánguò.", "english": "She's very upset.", "words": ["w-ta-she", "w-hen", "w-nanguo"] },
    { "id": "s25-biekule", "hanzi": "别哭了！", "pinyin": "Bié kū le!", "english": "Don't cry!", "words": ["w-bie", "w-ku", "w-le"] },
    { "id": "s25-zhenqiguai", "hanzi": "真奇怪！", "pinyin": "Zhēn qíguài!", "english": "How strange!", "words": ["w-zhen", "w-qiguai"] },
    { "id": "s25-xiexieguanxin", "hanzi": "谢谢你的关心。", "pinyin": "Xièxie nǐ de guānxīn.", "english": "Thanks for your concern.", "words": ["w-xiexie", "w-ni", "w-de", "w-guanxin"] },
    { "id": "s25-jiarenreqing", "hanzi": "你的家人都很热情。", "pinyin": "Nǐ de jiārén dōu hěn rèqíng.", "english": "Your family are all so welcoming.", "words": ["w-ni", "w-de", "w-jia", "w-ren", "w-dou", "w-hen", "w-reqing"] },
    { "id": "s25-faxianreqing", "hanzi": "我发现北京人都很热情。", "pinyin": "Wǒ fāxiàn Běijīng rén dōu hěn rèqíng.", "english": "I've found that Beijingers are really friendly.", "words": ["w-wo", "w-faxian", "w-beijing", "w-ren", "w-dou", "w-hen", "w-reqing"] },
    { "id": "s25-tebiepiaoliang", "hanzi": "北京的秋天特别漂亮。", "pinyin": "Běijīng de qiūtiān tèbié piàoliang.", "english": "Autumn in Beijing is especially beautiful.", "words": ["w-beijing", "w-de", "w-qiu", "w-tian", "w-tebie", "w-piaoliang"] },
    { "id": "s25-duomepiaoliang", "hanzi": "这儿多么漂亮啊！", "pinyin": "Zhèr duōme piàoliang a!", "english": "How beautiful it is here!", "words": ["w-zher", "w-duome", "w-piaoliang", "w-a"] },
    { "id": "s25-renweibanfahao", "hanzi": "我认为这个办法很好。", "pinyin": "Wǒ rènwéi zhège bànfǎ hěn hǎo.", "english": "I think this is a good idea.", "words": ["w-wo", "w-renwei", "w-zhe", "w-ge", "w-banfa", "w-hen", "w-hao"] },
    { "id": "s25-wotongyi", "hanzi": "我同意。", "pinyin": "Wǒ tóngyì.", "english": "I agree.", "words": ["w-wo", "w-tongyi"] },
    { "id": "s25-nitongyima", "hanzi": "你同意吗？", "pinyin": "Nǐ tóngyì ma?", "english": "Do you agree?", "words": ["w-ni", "w-tongyi", "w-ma"] },
    { "id": "s25-woxiangxinni", "hanzi": "我相信你！", "pinyin": "Wǒ xiāngxìn nǐ!", "english": "I believe in you!", "words": ["w-wo", "w-xiangxin", "w-ni"] },
    { "id": "s25-yuanyiquzhongguo", "hanzi": "你愿意跟我去中国吗？", "pinyin": "Nǐ yuànyì gēn wǒ qù Zhōngguó ma?", "english": "Would you come to China with me?", "words": ["w-ni", "w-yuanyi", "w-gen", "w-wo", "w-qu", "w-zhongguo", "w-ma"] },
    { "id": "s25-woyuanyi", "hanzi": "我愿意！", "pinyin": "Wǒ yuànyì!", "english": "I'd love to!", "words": ["w-wo", "w-yuanyi"], "alt": { "english": ["I'm willing!", "I do!"] } },
    { "id": "s25-buganchi", "hanzi": "我不敢吃这个。", "pinyin": "Wǒ bù gǎn chī zhège.", "english": "I don't dare eat this.", "words": ["w-wo", "w-bu", "w-gan", "w-chi", "w-zhe", "w-ge"] },
    { "id": "s25-haijidewoma", "hanzi": "你还记得我吗？", "pinyin": "Nǐ hái jìde wǒ ma?", "english": "Do you still remember me?", "words": ["w-ni", "w-hai-still", "w-jide", "w-wo", "w-ma"] },
    { "id": "s25-dangranjide", "hanzi": "当然记得！", "pinyin": "Dāngrán jìde!", "english": "Of course I remember!", "words": ["w-dangran", "w-jide"] },
    { "id": "s25-liaojiewenhua", "hanzi": "我想多了解中国文化。", "pinyin": "Wǒ xiǎng duō liǎojiě Zhōngguó wénhuà.", "english": "I want to learn more about Chinese culture.", "words": ["w-wo", "w-xiang", "w-duo", "w-liaojie", "w-zhongguo", "w-wenhua"] }
  ],
