  "grammar": [
    { "id": "g25-yiwei", "title": "以为 or 认为?", "body": "认为 gives your opinion: 我认为这个办法很好. 以为 is what you thought, but it turned out wrong: 我以为你不来了! (I thought you weren't coming!)", "examples": ["s25-woyiweinibulai", "s25-renweibanfahao", "s25-qishi-yiwei"] },
    { "id": "g25-bie", "title": "别…了: comforting", "body": "别 + feeling + 了 tells someone to stop feeling that way: 别生气了, 别哭了. 别着急 means don't worry, take your time.", "examples": ["s25-bieshengqile", "s25-biekule", "s25-biezhaoji-manman"] },
    { "id": "g25-duome", "title": "多么…啊!", "body": "多么 + adjective + 啊 is an exclamation: 多么漂亮啊! (How beautiful!). In speech 多 alone is common too.", "examples": ["s25-duomepiaoliang"] },
    { "id": "g25-manyi", "title": "对…很满意", "body": "对 + person/thing + 很满意: pleased with. 我爸爸对你很满意: my dad is happy with you.", "examples": ["s25-dangran-manyi"] }
  ],
