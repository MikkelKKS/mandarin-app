    { "id": "s-youyidianmang", "hanzi": "有一点忙。", "pinyin": "Yǒu yìdiǎn máng.", "english": "A bit busy.", "words": ["w-you", "w-yidian", "w-mang"] },
    { "id": "s-mang-youyisi", "hanzi": "有一点忙。可是我的工作很有意思。", "pinyin": "Yǒu yìdiǎn máng. Kěshì wǒ de gōngzuò hěn yǒuyìsi.", "english": "A bit busy. But my work is really interesting.", "words": ["w-you", "w-yidian", "w-mang", "w-keshi", "w-wo", "w-de", "w-gongzuo", "w-hen", "w-youyisi"] },
