    { "id": "s-nimeitianjidianshangban", "hanzi": "你每天几点上班？", "pinyin": "Nǐ měitiān jǐ diǎn shàngbān?", "english": "What time do you start work every day?", "words": ["w-ni", "w-meitian", "w-ji", "w-dian", "w-shangban"] },
