  "grammar": [
    { "id": "g-zaiplace", "title": "Where comes before the verb", "body": "在 + place goes before the verb: 我在大学工作 = I work at a university (lit. I at university work). Same for 你在哪里工作？", "examples": ["s-wozaidaxuegongzuo", "s-nizainaligongzuo"] },
    { "id": "g-zhuzai", "title": "住在 = live in", "body": "With 住 (live), the place comes after 在: 我住在哥本哈根. Ask with 你住在哪里？", "examples": ["s-nizhuzainali", "s-wozhuzaigebenhagen"] },
    { "id": "g-adjanota", "title": "忙不忙？ questions", "body": "Adjective + 不 + adjective makes a yes/no question: 忙不忙 (busy?), 难不难 (hard?). Answer with the adjective: 很忙, 不太难.", "examples": ["s-gongzuomangbumang", "s-shuxuenanbunan"] },
    { "id": "g-butai", "title": "不太 = not very", "body": "不太 + adjective softens a 'no': 不太难 = not too hard, 不太忙 = not very busy. More polite than a flat 不.", "examples": ["s-butainan"] }
  ],
