    { "id": "s-tamamashiyisheng", "hanzi": "她妈妈是医生。", "pinyin": "Tā māma shì yīshēng.", "english": "Her mum is a doctor.", "words": ["w-ta-she", "w-mama", "w-shi", "w-yisheng"] },
    { "id": "s-tababashilaoshi", "hanzi": "他爸爸是老师。", "pinyin": "Tā bàba shì lǎoshī.", "english": "His dad is a teacher.", "words": ["w-ta-he", "w-baba", "w-shi", "w-laoshi"] },
    { "id": "s-gegezaigongsigongzuo", "hanzi": "我哥哥在公司工作。", "pinyin": "Wǒ gēge zài gōngsī gōngzuò.", "english": "My older brother works at a company.", "words": ["w-wo", "w-gege", "w-zai", "w-gongsi", "w-gongzuo"] },
