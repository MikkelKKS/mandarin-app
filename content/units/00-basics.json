  "grammar": [
    { "id": "g-ma", "title": "Yes/no questions with 吗", "body": "Add 吗 (ma) to the end of any statement to make it a yes/no question. The word order doesn't change.\n你好 = hello → 你好吗？ = how are you?\n是 = it is → 是吗？ = is that so? / really?", "examples": ["s-nihaoma", "s-shima"] },
    { "id": "g-ne", "title": "Bouncing a question back with 呢", "body": "After answering, put 呢 (ne) after a person to ask them the same thing: 我很好，你呢？ = I'm fine, and you?", "examples": ["s-wohenhao-nine"] },
    { "id": "g-bu", "title": "不 changes its tone", "body": "不 is normally 4th tone (bù), but before another 4th tone it becomes 2nd tone: 不是 bú shì, 不客气 bú kèqi. The app accepts either when you type it.", "examples": ["s-bushi", "s-buhao"] }
  ],
